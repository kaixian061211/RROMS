@page
@model RROMS.Web.Pages.Payments.DemoModel
@{
    ViewData["Title"] = "Payments";
    var staff = User.IsInRole(PaymentRoles.Staff) || User.IsInRole(PaymentRoles.Admin);
}
<header class="rr-page-header"><div><h1>Payments</h1><p class="rr-lede">Choose how to pay, collect at the counter, and keep a clear record.</p></div></header>
<div class="payment-workspace">
    @if (staff)
    {
        <section class="rr-panel"><h2>Collect payment</h2><p>Collect waiting payments, find transactions, download receipts and record full refunds.</p><div class="payment-actions"><a class="btn btn-outline-secondary" asp-page="Counter">Counter queue</a><a class="btn btn-outline-secondary" asp-page="Index">Transactions</a></div></section>
    }
    else
    {
        <section class="rr-panel"><h2>Pay for orders</h2><p>Pay for your orders and return here for payment status, history and receipts.</p><div class="payment-actions"><a class="btn btn-primary" asp-page="MyOrders">Orders for payment</a><a class="btn btn-outline-secondary" asp-page="History">My payments</a></div></section>
    }
</div>
