@page
@model RROMS.Web.Pages.Payments.CheckoutModel
@{
    ViewData["Title"] = "Pay for your order";
    var order = Model.Order!;
}
<div class="rr-narrow">
    <partial name="_PaymentPageHeader" />
    <header class="rr-page-header">
        <div>
            <span class="rr-ref d-block mb-2">@PaymentFormatter.OrderReference(order.OrderId)</span>
            <h1>Pay for your order</h1>
            <p class="rr-lede">Choose online checkout or pay our staff at the counter.</p>
        </div>
    </header>
    <ol class="rr-steps payment-steps" aria-label="Payment progress">
        <li class="is-done">Order placed</li><li class="is-current" aria-current="step">Choose payment</li><li>Confirmation</li>
    </ol>
    @if (Model.CanCheckOnlineStatus)
    {
        <div class="alert alert-warning" role="status">
            <strong>An online checkout is already in progress.</strong>
            <p class="mb-2">Check it before paying again. We will verify or close the previous attempt before starting another.</p>
            <a asp-page="Success" asp-route-paymentId="@Model.ExistingPayment!.PaymentId" class="alert-link">Check payment status</a>
        </div>
    }
    <article class="rr-docket payment-docket mb-4" aria-labelledby="order-summary-title">
        <div class="rr-docket__head">
            <div><h2 id="order-summary-title" class="rr-docket__title">Order summary</h2><span class="rr-ref">@PaymentFormatter.OrderReference(order.OrderId)</span></div>
            <span class="rr-label">MYR</span>
        </div>
        <div class="rr-docket__total payment-total"><span>Amount due</span><strong class="rr-money">@PaymentFormatter.Money(order.TotalAmount)</strong></div>
        <p class="payment-note mt-2 mb-0">The total comes from your saved order.</p>
    </article>
    <form method="post" data-payment-submit data-payment-checkout data-payment-busy="Opening checkout…">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="OrderId" />
        <fieldset class="rr-panel payment-picker">
            <legend>How would you like to pay?</legend>
            @if (Model.MustResumeOnlineCheckout)
            {
                <p class="payment-note">Resume your previous @PaymentFormatter.MethodLabel(Model.ExistingPayment!.Method).ToLowerInvariant() checkout first. Its outcome is still unconfirmed.</p>
            }
            <div class="rr-tiles rr-tiles--wide payment-methods">
                @foreach (var option in CheckoutModel.MethodOptions)
                {
                    var id = "method-" + option.Value;
                    <div class="payment-choice-wrap">
                        <input asp-for="Method" type="radio" class="btn-check" id="@id" value="@option.Value" required disabled="@(Model.MustResumeOnlineCheckout && option.Value != Model.ExistingPayment!.Method)" />
                        <label for="@id" class="rr-tile payment-method">
                            <span class="payment-method__mark" aria-hidden="true"></span>
                            <span class="payment-method__body"><strong>@option.Title</strong><small>@option.Description</small></span>
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="Method" class="text-danger"></span>
            <p class="payment-note mt-3 mb-0" data-payment-method-note>Online payment opens Stripe. Payment is confirmed only after verification.</p>
        </fieldset>
        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary" data-payment-checkout-button>@(Model.MustResumeOnlineCheckout ? "Resume previous checkout" : "Continue to Stripe")</button>
            <a class="btn btn-outline-secondary" asp-page="MyOrders">Back to orders</a>
        </div>
        <p class="payment-note mt-3">Card and banking details are entered on Stripe. RROMS does not store them.</p>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
