@page
@model RROMS.Web.Pages.Payments.SuccessModel
@{
    var payment = Model.Payment!;
    var title = payment.Status switch { PaymentStatus.Paid => "Payment received", PaymentStatus.Refunded => "Payment refunded", PaymentStatus.Pending when payment.IsAwaitingCounter => "Pay at the counter", PaymentStatus.Pending => "Confirming your payment", _ => "Payment not confirmed" };
    ViewData["Title"] = title;
}
<div class="rr-narrow">
    <partial name="_PaymentPageHeader" />
    <header class="rr-page-header"><div><span class="rr-ref d-block mb-2">@payment.ReceiptNo</span><h1>@title</h1><p class="rr-lede">@PaymentFormatter.OrderReference(payment.OrderId)</p></div></header>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-warning" role="status">@Model.StatusMessage</div> }
    <article class="rr-docket payment-docket payment-outcome" aria-labelledby="outcome-title">
        <div class="rr-docket__head"><h2 id="outcome-title" class="rr-docket__title">RROMS</h2><span class="@PaymentFormatter.StatusPill(payment.Status, payment.Method)">@PaymentFormatter.StatusText(payment.Status, payment.Method)</span></div>
        <div class="rr-docket__total payment-total"><span>@(payment.Status == PaymentStatus.Paid ? "Received" : payment.Status == PaymentStatus.Refunded ? "Refunded" : "Order total")</span><strong class="rr-money">@PaymentFormatter.Money(payment.Amount)</strong></div>
        <div class="payment-outcome__message">
            @if (payment.Status == PaymentStatus.Paid)
            { <p>Thank you. Your payment is confirmed and your receipt is ready.</p><p class="payment-note mb-0">Paid @PaymentFormatter.WhenUtc(payment.PaidAt) MYT · @PaymentFormatter.MethodLabel(payment.Method)</p> }
            else if (payment.IsAwaitingCounter)
            { <p>Please pay our staff at the counter. Your payment will be confirmed once they receive the full amount.</p><p class="payment-note mb-0">Show order <span class="rr-ref">@PaymentFormatter.OrderReference(payment.OrderId)</span> when you pay.</p> }
            else if (payment.Status == PaymentStatus.Pending)
            {
                <p id="poll-note" role="status" aria-live="polite">Your payment has not been confirmed yet. Check its status before paying again.</p>
                @if (Model.ShouldPoll) { <div class="payment-watching"><span class="spinner-border spinner-border-sm" aria-hidden="true" data-payment-spinner></span><span class="payment-note">Watching for a saved payment update.</span></div><div id="poll" data-url="@Url.Page("/Payments/Success", "Status", new { paymentId = payment.PaymentId })"></div> }
                else if (string.IsNullOrWhiteSpace(payment.TransactionRef)) { <p class="payment-note mb-0">The checkout response was interrupted. Resume the same checkout from your payment options; do not start a separate payment.</p> }
            }
            else if (payment.Status == PaymentStatus.Refunded)
            { <p>The full amount has been refunded. Your receipt keeps both the original payment and refund details.</p><p class="payment-note mb-0">Refunded @PaymentFormatter.WhenUtc(payment.RefundedAt) MYT.</p> }
            else
            { <p>No confirmed payment is recorded for this attempt.</p><p class="payment-note mb-0">If your bank or wallet shows a charge, check payment status or contact the restaurant before paying again.</p> }
        </div>
    </article>
    <div class="payment-actions mt-4">
        @if (payment.HasReceipt) { <a class="btn btn-primary" asp-page="Receipt" asp-route-id="@payment.PaymentId">Download receipt</a> }
        @if (Model.CanRefreshFromStripe)
        {
            <form method="post" asp-page-handler="Refresh" data-payment-submit data-payment-busy="Checking Stripe…"><input type="hidden" name="paymentId" value="@payment.PaymentId" /><button type="submit" class="btn btn-primary">Check payment status</button></form>
        }
        @if (!payment.HasReceipt && !payment.IsAwaitingCounter && payment.OrderStatus != RROMS.Web.Models.OrdersAndReservations.OrderStatus.Cancelled)
        { <a class="btn btn-outline-secondary" asp-page="CheckOut" asp-route-orderId="@payment.OrderId">@(string.IsNullOrWhiteSpace(payment.TransactionRef) && payment.Status == PaymentStatus.Pending ? "Resume previous checkout" : "Review payment options")</a> }
        <a class="btn btn-outline-secondary" asp-page="@(payment.HasReceipt ? "History" : "MyOrders")">@(payment.HasReceipt ? "My payments" : "Back to orders")</a>
    </div>
</div>
@section Scripts { @if (Model.ShouldPoll) { <script src="~/js/payments-status.js" asp-append-version="true"></script> } }
