@page
@model RROMS.Web.Pages.Payments.CancelModel
@using RROMS.Web.Models.Payments

@{
    ViewData["Title"] = Model.Cancelled
        ? "Checkout cancelled"
        : "Checkout status";
}

<partial name="_PaymentPageHeader" />

<div class="status-panel text-center">
    <div class="status-icon pending mb-3" aria-hidden="true">!</div>

    <h1 class="h3">@ViewData["Title"]</h1>

    <p class="text-muted">
        Order #@Model.Payment.OrderId
    </p>

    <p>@Model.Message</p>

    <div asp-validation-summary="All"
         class="text-danger mb-3"
         role="alert"></div>

    @if (Model.CanCancel)
    {
        <form method="post" class="mb-3">
            <input type="hidden" asp-for="PaymentId" />
            <input type="hidden" asp-for="Attempt" />

            <button type="submit" class="btn btn-outline-danger">
                Cancel this checkout
            </button>
        </form>
    }

    <div class="d-flex justify-content-center gap-2">
        @if (Model.Payment.Status == PaymentStatus.Failed)
        {
            <a class="btn btn-primary"
               asp-page="CheckOut"
               asp-route-orderId="@Model.Payment.OrderId">
                Choose how to pay
            </a>
        }

        <a class="btn btn-outline-secondary"
           asp-page="MyOrders">
            My orders
        </a>
    </div>
</div>