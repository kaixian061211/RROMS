@page
@model RROMS.Web.Pages.Payments.MyOrdersModel
@{ ViewData["Title"] = "Orders for payment"; }
<div class="rr-narrow">
    <partial name="_PaymentPageHeader" />
    <header class="rr-page-header"><div><h1>Orders for payment</h1><p class="rr-lede">Pay online, choose the counter, or check an earlier payment.</p></div><div class="rr-page-actions"><a class="btn btn-primary" asp-page="/Orders/Create">Order food</a></div></header>
    @if (Model.Orders.Count == 0)
    {
        <div class="rr-empty"><h2 class="rr-empty__title">No orders to pay for yet</h2><p>Place an order to choose how you would like to pay. Your orders and payment outcomes will appear here.</p></div>
    }
    else
    {
        <div class="payment-records">
        @foreach (var order in Model.Orders)
        {
            var status = order.Status;
            <article class="rr-slip payment-slip" aria-labelledby="order-@order.OrderId">
                <div class="rr-slip__body">
                    <div class="payment-slip__head"><h2 id="order-@order.OrderId" class="payment-card-title rr-ref">@PaymentFormatter.OrderReference(order.OrderId)</h2><span class="@(status is null ? "rr-status rr-status--attention" : PaymentFormatter.StatusPill(status, order.Method))">@(status is null ? "Unpaid" : PaymentFormatter.StatusText(status, order.Method))</span></div>
                    <div class="payment-slip__summary"><span class="payment-note">Order total</span><strong class="rr-money">@PaymentFormatter.Money(order.TotalAmount)</strong></div>
                    @if (order.IsAwaitingCounter) { <p class="payment-note mb-0">Please pay our staff at the restaurant.</p> }
                    <div class="payment-actions mt-3">
                        @if (order.CanCheckOnlineStatus) { <a class="btn btn-outline-secondary" asp-page="Success" asp-route-paymentId="@order.PaymentId">Check payment status</a> }
                        @if (status is PaymentStatus.Paid or PaymentStatus.Refunded && order.PaymentId is not null)
                        { <a class="btn btn-outline-secondary" asp-page="Receipt" asp-route-id="@order.PaymentId">Download receipt</a> }
                        else if (order.OrderStatus == RROMS.Web.Models.OrdersAndReservations.OrderStatus.Cancelled)
                        { <span class="rr-status rr-status--off">Order cancelled</span> }
                        else
                        { <a class="btn btn-outline-secondary" asp-page="CheckOut" asp-route-orderId="@order.OrderId">@(status is null ? "Choose how to pay" : status == PaymentStatus.Failed ? "Review payment options" : "Review payment")</a> }
                    </div>
                </div>
            </article>
        }
        </div>
    }
</div>
