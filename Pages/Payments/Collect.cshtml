@page "{id:int}"
@model RROMS.Web.Pages.Payments.CollectModel
@{
    ViewData["Title"] = "Collect payment";
    var payment = Model.Payment!;
}

<partial name="_PaymentPageHeader" />

<div class="row g-4">
    <div class="col-lg-7">
        <h1 class="h3 mb-1">Collect payment</h1>
        <p class="text-muted">Take the money first, then record how the customer paid.</p>

        <form method="post">
            <div class="d-grid gap-2 mb-3">
                @foreach (var method in PaymentMethod.CounterMethods)
                {
                    <label class="method-option">
                        <input type="radio" name="Method" value="@method" checked="@(method == Model.Method)" />
                        <strong>@PaymentFormatter.MethodLabel(method)</strong>
                    </label>
                }
            </div>

            <div id="cash-box" class="bill p-3 mb-4">
                <label for="tendered" class="form-label">Cash received (optional, to work out the change)</label>
                <div class="input-group mb-2" style="max-width: 16rem;">
                    <span class="input-group-text">RM</span>
                    <input id="tendered" type="number" min="0" step="0.05" class="form-control" data-amount="@payment.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="bill-row"><span class="label">Change to give</span><strong id="change">RM 0.00</strong></div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Record payment</button>
            <a class="btn btn-link" asp-page="Counter">Back to queue</a>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="bill p-4">
            <h2 class="h6 text-muted mb-3">Payment @payment.ReceiptNo</h2>
            <div class="bill-row"><span class="label">Customer</span><span>@payment.CustomerName</span></div>
            <div class="bill-row"><span class="label">Order</span><span>@payment.OrderLabel</span></div>
            <div class="bill-row"><span class="label">Waiting since</span><span>@PaymentFormatter.When(payment.CreatedAt)</span></div>
            <div class="bill-total"><span>Amount due</span><span>@PaymentFormatter.Money(payment.Amount)</span></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/payments-collect.js" asp-append-version="true"></script>
}