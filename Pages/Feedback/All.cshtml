@page
@model AllModel
@{
    ViewData["Title"] = Model.IsAdminView ? "Manage feedback" : "Customer feedback";
}

@* Customers read this in one narrow column; staff and admin get the full width, as the design guide says. *@
<div class="@(Model.IsStaffView ? null : "rr-narrow")">
    <header class="rr-page-header">
        <div>
            <h1>@(Model.IsAdminView ? "Manage feedback" : "Customer feedback")</h1>
            @if (Model.IsAdminView)
            {
                <p class="rr-lede">Reply to customers, and hide comments that shouldn't be shown. Hidden comments stay in the database.</p>
            }
            else if (Model.IsStaffView)
            {
                <p class="rr-lede">What customers say about their visits, newest first. Staff can read feedback but not change it.</p>
            }
            else
            {
                <p class="rr-lede">What customers say about their visits, newest first.</p>
            }
        </div>
    </header>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <nav class="nav nav-pills mb-4" aria-label="Rating">
        <a asp-page="All" class="nav-link @(Model.Stars is null ? "active" : null)"
           aria-current="@(Model.Stars is null ? "page" : null)">All</a>
        @for (var stars = 5; stars >= 1; stars--)
        {
            <a asp-page="All" asp-route-stars="@stars" class="nav-link @(stars == Model.Stars ? "active" : null)"
               aria-current="@(stars == Model.Stars ? "page" : null)">@FeedbackFormatter.FilterLabel(stars)</a>
        }
    </nav>

    @if (Model.Items.Count == 0)
    {
        <div class="rr-empty">
            <p class="rr-empty__title">No feedback to show.</p>
            <p class="mb-0">@(Model.Stars is null ? "Feedback appears here once customers rate their visits." : "No one has given this rating yet. Try another one.")</p>
        </div>
    }
    else
    {
        <ul class="list-unstyled d-grid gap-3 mb-0">
            @foreach (var f in Model.Items)
            {
                <li class="rr-slip">
                    <div class="rr-slip__body">
                        <div>
                            <div class="rr-slip__title">
                                <span aria-hidden="true">@FeedbackFormatter.Stars(f.Rating)</span>
                                <span class="visually-hidden">@FeedbackFormatter.StarsLabel(f.Rating)</span>
                                @if (f.IsHidden)
                                {
                                    <span class="badge text-bg-secondary ms-2">Hidden</span>
                                }
                            </div>
                            <span class="small text-muted">@f.DisplayName · @FeedbackFormatter.When(f.CreatedAt)</span>
                            @if (Model.IsStaffView)
                            {
                                <span class="rr-ref ms-2">@FeedbackFormatter.Visit(f.OrderId, f.ReservationId)</span>
                            }
                            @if (f.Comments is not null)
                            {
                                <p class="mt-2 mb-0">@f.Comments</p>
                            }
                            @if (f.AdminReply is not null)
                            {
                                <p class="small mt-2 mb-0"><strong>Reply from the restaurant:</strong> @f.AdminReply</p>
                            }
                        </div>
                        @if (Model.IsAdminView)
                        {
                            <div class="rr-slip__side">
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-page="Reply" asp-route-id="@f.FeedbackId" class="btn btn-sm btn-outline-secondary">
                                        @(f.AdminReply is null ? "Reply" : "Edit reply")<span class="visually-hidden"> to @f.DisplayName</span>
                                    </a>
                                    <form method="post" asp-page-handler="@(f.IsHidden ? "Show" : "Hide")" asp-route-id="@f.FeedbackId" asp-route-stars="@Model.Stars">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            @(f.IsHidden ? "Show again" : "Hide")<span class="visually-hidden"> feedback from @f.DisplayName</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
