@page
@model IndexModel
@{
    ViewData["Title"] = "My feedback";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>My feedback</h1>
            <p class="rr-lede">Your ratings and comments about past visits.</p>
        </div>
        <div class="rr-page-actions">
            @if (Model.Items.Count > 0 && Model.ToRateCount > 0)
            {
                <a asp-page="Create" class="btn btn-primary">Rate a visit</a>
            }
            <a asp-page="All" class="btn btn-outline-secondary">What others say</a>
        </div>
    </header>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="rr-empty">
            <p class="rr-empty__title">You haven't sent any feedback yet.</p>
            @if (Model.ToRateCount > 0)
            {
                <p class="mb-0">You have @Model.ToRateCount completed @(Model.ToRateCount == 1 ? "visit" : "visits") you can rate.</p>
                <a asp-page="Create" class="btn btn-primary">Rate a visit</a>
            }
            else
            {
                <p class="mb-0">Once an order or reservation is completed, you can rate it here.</p>
            }
        </div>
    }
    else
    {
        <ul class="list-unstyled d-grid gap-3 mb-0">
            @foreach (var f in Model.Items)
            {
                var reference = FeedbackFormatter.Visit(f.OrderId, f.ReservationId);
                <li class="rr-slip">
                    <div class="rr-slip__body">
                        <div>
                            <div class="rr-slip__title">
                                <span aria-hidden="true">@FeedbackFormatter.Stars(f.Rating)</span>
                                <span class="visually-hidden">@FeedbackFormatter.StarsLabel(f.Rating)</span>
                            </div>
                            <span class="rr-ref">@reference</span>
                            <span class="small text-muted"> · @FeedbackFormatter.When(f.CreatedAt)</span>
                            @if (f.Comments is not null)
                            {
                                <p class="mt-2 mb-0">@f.Comments</p>
                            }
                            @if (f.AdminReply is not null)
                            {
                                <p class="small mt-2 mb-0"><strong>Reply from the restaurant:</strong> @f.AdminReply</p>
                            }
                        </div>
                        <div class="rr-slip__side">
                            @* The hidden reference tells a screen reader which feedback each button is for. *@
                            <div class="d-flex gap-2">
                                <a asp-page="Edit" asp-route-id="@f.FeedbackId" class="btn btn-sm btn-outline-secondary">Edit<span class="visually-hidden"> feedback for @reference</span></a>
                                <a asp-page="Delete" asp-route-id="@f.FeedbackId" class="btn btn-sm btn-outline-danger">Delete<span class="visually-hidden"> feedback for @reference</span></a>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>
