@page
@model RROMS.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>Forgot your password?</h1>
            <p class="rr-lede">Enter your account email and we will send you a 6-digit code.</p>
        </div>
    </header>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="rr-panel">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Send code</button>
            <a asp-page="Login" class="btn btn-outline-secondary">Back to log in</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
