@page
@model RROMS.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>Log in</h1>
            <p class="rr-lede">Log in to book a table, order from it and follow your visits.</p>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        <div class="rr-panel">
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
                <p class="small mt-2 mb-0"><a asp-page="ForgotPassword">Forgot your password?</a></p>
            </div>
        </div>

        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Log in</button>
            <a asp-page="Register" class="btn btn-outline-secondary">Create an account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
