@page
@model RROMS.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>Reset your password</h1>
            <p class="rr-lede">Enter the code from your email and choose a new password.</p>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="rr-panel">
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Otp" class="form-label"></label>
                <input asp-for="Input.Otp" class="form-control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                <span asp-validation-for="Input.Otp" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.NewPassword" class="form-label"></label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Reset password</button>
            <a asp-page="ForgotPassword" class="btn btn-outline-secondary">Send a new code</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
