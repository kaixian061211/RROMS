@page
@model RROMS.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My profile";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            @if (Model.HasAccount)
            {
                <span class="rr-label">@Model.Role</span>
            }
            <h1>My profile</h1>
            <p class="rr-lede">Keep your contact details up to date.</p>
        </div>
    </header>

    @if (!Model.HasAccount)
    {
        <div class="alert alert-warning" role="alert">
            This sign-in is a Development test user, so it has no account to edit. Log in with a real account to manage a profile.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success" role="status">@Model.StatusMessage</div>
        }

        <form method="post" asp-page-handler="Profile" class="mb-5">
            <div class="rr-panel">
                <h2 class="h3 mb-4">Personal details</h2>
                <div class="mb-4">
                    <label asp-for="Profile.FullName" class="form-label"></label>
                    <input asp-for="Profile.FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Profile.Email" class="form-label"></label>
                    <input asp-for="Profile.Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Profile.Email" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Profile.Phone" class="form-label">Phone number (optional)</label>
                    <input asp-for="Profile.Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Profile.Phone" class="text-danger"></span>
                </div>
            </div>
            <div class="rr-actionbar">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>

        <form method="post" asp-page-handler="Password">
            <div class="rr-panel">
                <h2 class="h3 mb-4">Change password</h2>
                <div class="mb-4">
                    <label asp-for="Password.CurrentPassword" class="form-label"></label>
                    <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password.CurrentPassword" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password.NewPassword" class="form-label"></label>
                    <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password.NewPassword" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <div class="rr-actionbar">
                <button type="submit" class="btn btn-outline-secondary">Change password</button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
