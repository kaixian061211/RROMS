@page
@model RROMS.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create an account";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>Create an account</h1>
            <p class="rr-lede">One account for your bookings, orders and payments.</p>
        </div>
    </header>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="rr-panel">
            <div class="mb-4">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Phone" class="form-label"></label>
                <input asp-for="Input.Phone" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Input.Phone" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Create account</button>
            <a asp-page="Login" class="btn btn-outline-secondary">I already have an account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
