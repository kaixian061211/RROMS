@page
@model IndexModel
@{
    ViewData["Title"] = "My preferences";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>My preferences</h1>
            <p class="rr-lede">Tell us what you like, so we can look after you better. Our staff can see this.</p>
        </div>
        <div class="rr-page-actions">
            <a asp-page="/History/Index" class="btn btn-outline-secondary">My history</a>
        </div>
    </header>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="rr-panel">
            <div class="mb-4">
                <label asp-for="Input.DietaryNeeds" class="form-label"></label>
                <input asp-for="Input.DietaryNeeds" class="form-control" maxlength="200"
                       placeholder="For example: vegetarian, no peanuts" />
                <span asp-validation-for="Input.DietaryNeeds" class="text-danger"></span>
                <div class="form-text">Anything we should know about what you can't eat.</div>
            </div>

            <fieldset class="mb-4">
                <legend class="form-label fs-6">Favourite categories</legend>
                @if (Model.Categories.Count == 0)
                {
                    <p class="text-muted mb-0">The menu has no categories yet.</p>
                }
                else
                {
                    for (var i = 0; i < Model.Categories.Count; i++)
                    {
                        var category = Model.Categories[i];
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="category-@i" name="Input.FavouriteCategories"
                                   value="@category" checked="@Model.Input.FavouriteCategories.Contains(category, StringComparer.OrdinalIgnoreCase)" />
                            <label class="form-check-label" for="category-@i">@category</label>
                        </div>
                    }
                }
            </fieldset>

            <div>
                <label asp-for="Input.SeatingPreferences" class="form-label"></label>
                <select asp-for="Input.SeatingPreferences" class="form-select">
                    <option value="">No preference</option>
                    @foreach (var area in Model.Areas)
                    {
                        <option value="@area">@area</option>
                    }
                </select>
                <span asp-validation-for="Input.SeatingPreferences" class="text-danger"></span>
            </div>
        </div>

        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Save preferences</button>
        </div>
        @if (Model.UpdatedAt is not null)
        {
            <p class="small text-muted mt-3 mb-0">Last saved @(Model.UpdatedAt.Value.ToString("dd MMM yyyy, h:mm tt", System.Globalization.CultureInfo.InvariantCulture))</p>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
