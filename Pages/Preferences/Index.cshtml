@page
@model IndexModel
@{
    ViewData["Title"] = "My preferences";
    var options = Model.Options;
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>My preferences</h1>
            <p class="rr-lede">Tell us what you like. The restaurant's staff can read this, but only you can change it.</p>
        </div>
    </header>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="rr-panel">
            <div class="mb-4">
                <label asp-for="Input.DietaryNeeds" class="form-label"></label>
                <textarea asp-for="Input.DietaryNeeds" class="form-control" rows="3" maxlength="@PreferenceInput.MaxDietaryNeedsLength"
                          placeholder="For example: no peanuts, halal only, vegetarian"></textarea>
                <span asp-validation-for="Input.DietaryNeeds" class="text-danger"></span>
            </div>

            <fieldset class="mb-4">
                <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.Input.FavouriteCategories)</legend>
                @if (options.Categories.Count == 0)
                {
                    <p class="text-muted mb-0">The menu has no categories yet.</p>
                }
                else
                {
                    <div class="rr-tiles rr-tiles--wide">
                        @for (var i = 0; i < options.Categories.Count; i++)
                        {
                            var category = options.Categories[i];
                            var tileId = $"category_{i}";
                            <input type="checkbox" class="btn-check" id="@tileId" name="@Html.NameFor(m => m.Input.FavouriteCategories)" value="@category"
                                   checked="@Model.Input.FavouriteCategories.Contains(category, StringComparer.OrdinalIgnoreCase)" />
                            <label class="rr-tile" for="@tileId">@category</label>
                        }
                    </div>
                }
            </fieldset>

            <fieldset class="mb-0">
                <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.Input.SeatingPreference)</legend>
                <div class="rr-tiles rr-tiles--wide">
                    <input type="radio" class="btn-check" id="seating_none" name="@Html.NameFor(m => m.Input.SeatingPreference)" value=""
                           checked="@string.IsNullOrWhiteSpace(Model.Input.SeatingPreference)" />
                    <label class="rr-tile" for="seating_none">No preference</label>
                    @for (var i = 0; i < options.SeatingAreas.Count; i++)
                    {
                        var area = options.SeatingAreas[i];
                        var tileId = $"seating_{i}";
                        <input type="radio" class="btn-check" id="@tileId" name="@Html.NameFor(m => m.Input.SeatingPreference)" value="@area"
                               checked="@string.Equals(Model.Input.SeatingPreference, area, StringComparison.OrdinalIgnoreCase)" />
                        <label class="rr-tile" for="@tileId">@area</label>
                    }
                </div>
                <span asp-validation-for="Input.SeatingPreference" class="text-danger"></span>
            </fieldset>
        </div>
        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-page="/History/Index" class="btn btn-outline-secondary">Back<span class="d-none d-sm-inline"> to my history</span></a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
