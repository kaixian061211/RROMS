@page
@model RROMS.Web.Pages.Tracking.IndexModel
@using RROMS.Web.Models.OrdersAndReservations
@using RROMS.Web.Models.Payments
@using RROMS.Web.Models.Tracking

@{
    ViewData["Title"] = "Track status";
}

<div class="rr-narrow tracking-page">
    <header class="rr-page-header">
        <div>
            <h1>@(Model.TrackedReservation is not null ? "Track your booking" : "Track your order")</h1>
            <p class="rr-lede">Your current status and the details you need.</p>
        </div>
    </header>

    <p class="tracking-auto">This page checks for updates automatically while it is open.</p>
    <div id="tracking-updates-banner" class="alert alert-warning" role="status" aria-live="polite" hidden>
        <div class="tracking-refresh">
            <span>We couldn't refresh this status. Your last update is shown below.</span>
            <button id="tracking-refresh-button" class="btn btn-outline-secondary" type="button">Try again</button>
        </div>
    </div>

    <div id="tracking-content"
         data-order-id="@Model.TrackedOrder?.OrderId"
         data-reservation-id="@Model.TrackedReservation?.ReservationId"
         data-snapshot="@Model.Snapshot" aria-live="polite" aria-atomic="true">
        @if (Model.TrackedOrder is { } order)
        {
            <section class="rr-docket" aria-labelledby="tracked-order-title">
                <div class="rr-docket__head">
                    <div>
                        <span class="rr-ref">@OrderFormatter.Reference(order.OrderId)</span>
                        <h2 id="tracked-order-title">Your order</h2>
                    </div>
                    <span class="@OrderFormatter.StatusBadge(order.Status)">@OrderFormatter.StatusLabel(order.Status)</span>
                </div>
                <dl class="tracking-details">
                    <div><dt>Table</dt><dd>@ReservationFormatter.TableNumber(order.TableId, Model.Tables)</dd></div>
                    <div><dt>Placed</dt><dd>@OrderFormatter.PlacedAt(order.CreatedAt)</dd></div>
                </dl>
                @if (order.Status != OrderStatus.Cancelled)
                {
                    <div class="tracking-progress">
                        <ol class="rr-steps" aria-label="Order progress">
                            @foreach (var step in OrderFormatter.Steps)
                            {
                                var stepClass = OrderFormatter.StepClass(order.Status, step);
                                <li class="@stepClass" aria-current="@(stepClass == "is-current" ? "step" : null)">@OrderFormatter.StatusLabel(step)</li>
                            }
                        </ol>
                    </div>
                }
                <div class="rr-docket__actions">
                    <a class="btn btn-outline-secondary" asp-page="/Orders/Details" asp-route-id="@order.OrderId">View order details</a>
                </div>
            </section>

            <section class="rr-docket" aria-labelledby="tracked-payment-title">
                <div class="rr-docket__head">
                    <div>
                        @if (Model.TrackedPayment is { } referencePayment)
                        {
                            <span class="rr-ref">Payment #@referencePayment.PaymentId</span>
                        }
                        <h2 id="tracked-payment-title">Payment</h2>
                    </div>
                    @if (Model.TrackedPayment is { } statusPayment)
                    {
                        <span class="@TrackingFormatter.PaymentStatusClass(statusPayment)">@TrackingFormatter.PaymentLabel(statusPayment)</span>
                    }
                </div>
                @if (Model.TrackedPayment is { } payment)
                {
                    <dl class="tracking-details">
                        <div><dt>Amount</dt><dd class="rr-money tracking-amount">@PaymentFormatter.Money(payment.Amount)</dd></div>
                        <div><dt>Method</dt><dd>@PaymentFormatter.MethodLabel(payment.PaymentMethod)</dd></div>
                        @if (payment.PaidAt.HasValue)
                        {
                            <div><dt>Payment received</dt><dd>@PaymentFormatter.When(payment.PaidAt)</dd></div>
                        }
                        @if (payment.RefundedAt.HasValue)
                        {
                            <div><dt>Refund recorded</dt><dd>@PaymentFormatter.When(payment.RefundedAt)</dd></div>
                        }
                    </dl>
                    @if (payment.PaymentStatus is PaymentStatus.Paid or PaymentStatus.Refunded)
                    {
                        <div class="rr-docket__actions">
                            <a class="btn btn-outline-secondary" asp-page="/Payments/Receipt" asp-route-id="@payment.PaymentId">Download receipt</a>
                        </div>
                    }
                }
                else
                {
                    <p class="tracking-note">No payment has been started for this order.</p>
                }
            </section>
        }

        @if (Model.TrackedReservation is { } reservation)
        {
            <section class="rr-docket" aria-labelledby="tracked-reservation-title">
                <div class="rr-docket__head">
                    <div>
                        <span class="rr-ref">@ReservationFormatter.Reference(reservation.ReservationId)</span>
                        <h2 id="tracked-reservation-title">Your booking</h2>
                    </div>
                    <span class="@ReservationFormatter.StatusBadge(reservation.Status)">@ReservationFormatter.StatusLabel(reservation.Status)</span>
                </div>
                <dl class="tracking-details">
                    <div><dt>Date and time</dt><dd>@ReservationFormatter.When(reservation.ReservationDate, reservation.TimeSlot)</dd></div>
                    <div><dt>Party size</dt><dd>@ReservationFormatter.PartySize(reservation.PartySize)</dd></div>
                    <div><dt>Table</dt><dd>@ReservationFormatter.TableNumber(reservation.TableId, Model.Tables)</dd></div>
                </dl>
                <div class="rr-docket__actions">
                    <a class="btn btn-outline-secondary" asp-page="/Reservations/Confirmation" asp-route-id="@reservation.ReservationId">View booking details</a>
                </div>
            </section>
        }
    </div>

    <div class="tracking-footer">
        <a class="btn btn-outline-secondary" asp-page="/Notifications/Index">Back to notifications</a>
    </div>
</div>
