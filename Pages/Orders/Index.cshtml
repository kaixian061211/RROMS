@page
@model IndexModel
@{
    ViewData["Title"] = "My orders";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>My orders</h1>
            <p class="rr-lede">Everything you've ordered, newest first.</p>
        </div>
        @if (Model.Orders.Count > 0)
        {
            <div class="rr-page-actions">
                <a asp-page="Create" class="btn btn-primary">Order food</a>
            </div>
        }
    </header>

    @if (Model.Orders.Count == 0)
    {
        <div class="rr-empty">
            <p class="rr-empty__title">You haven't placed any orders yet.</p>
            <p class="mb-0">Order from your table and it will show up here.</p>
            <a asp-page="Create" class="btn btn-primary">Order food</a>
        </div>
    }
    else
    {
        <ul class="list-unstyled d-grid gap-3 mb-0">
            @foreach (var details in Model.Orders)
            {
                var o = details.Order;
                var reference = OrderFormatter.Reference(o.OrderId);
                <li class="rr-slip">
                    <div class="rr-slip__body">
                        <div>
                            <div class="rr-slip__title">
                                @OrderFormatter.Table(o.TableId) · @OrderFormatter.ItemCount(o) · <span class="rr-money">@OrderFormatter.Money(o.Total)</span>
                            </div>
                            <span class="rr-ref">@reference</span>
                            <span class="small text-muted">· @OrderFormatter.PlacedAt(o.CreatedAt)</span>
                        </div>
                        <div class="rr-slip__side">
                            <span class="@OrderFormatter.StatusBadge(o.Status)">@OrderFormatter.StatusLabel(o.Status)</span>
                            @* The hidden reference tells a screen reader which order each button is for. *@
                            <div class="d-flex gap-2">
                                @* Payment until the order is paid; then its receipt. A cancelled order has neither. *@
                                @if (details.CanPay)
                                {
                                    <a asp-page="/Payments/CheckOut" asp-route-orderId="@o.OrderId" class="btn btn-sm btn-outline-primary">Payment<span class="visually-hidden"> for @reference</span></a>
                                }
                                else if (details.Payment is { HasReceipt: true } payment)
                                {
                                    <a asp-page="/Payments/Receipt" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-secondary">Receipt<span class="visually-hidden"> for @reference</span></a>
                                }
                                <a asp-page="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-secondary">View<span class="visually-hidden"> @reference</span></a>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>
