@page
@model IndexModel
@{
    ViewData["Title"] = "My orders";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">My orders</h1>
    <a asp-page="Create" class="btn btn-primary">Order food</a>
</div>

@if (Model.Orders.Count == 0)
{
    <div class="text-center text-muted border rounded py-5">
        <p class="mb-3">You haven't placed any orders yet.</p>
        <a asp-page="Create" class="btn btn-outline-primary">Order food</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    @* On phones (below md) these columns are hidden, and the Order cell shows their details instead. *@
                    <th class="d-none d-md-table-cell">Items</th>
                    <th class="text-end d-none d-md-table-cell">Total</th>
                    <th class="d-none d-md-table-cell">Table</th>
                    <th class="d-none d-md-table-cell">Status</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td>
                            @OrderFormatter.Reference(o.OrderId)
                            <div class="small text-muted">@OrderFormatter.PlacedAt(o.CreatedAt)</div>
                            <div class="small d-md-none">
                                @OrderFormatter.Table(o.TableId) · @OrderFormatter.ItemCount(o) · <span class="text-nowrap">@OrderFormatter.Money(o.Total)</span>
                            </div>
                            <span class="badge d-md-none @OrderFormatter.StatusBadge(o.Status)">@OrderFormatter.StatusLabel(o.Status)</span>
                        </td>
                        <td class="text-nowrap d-none d-md-table-cell">@OrderFormatter.ItemCount(o)</td>
                        <td class="text-end text-nowrap d-none d-md-table-cell">@OrderFormatter.Money(o.Total)</td>
                        <td class="text-nowrap d-none d-md-table-cell">@OrderFormatter.Table(o.TableId)</td>
                        <td class="d-none d-md-table-cell"><span class="badge @OrderFormatter.StatusBadge(o.Status)">@OrderFormatter.StatusLabel(o.Status)</span></td>
                        <td class="text-end text-nowrap">
                            @* A cancelled order has nothing to pay. TODO: also hide it once the order is paid (Session 10). *@
                            @if (o.Status != OrderStatus.Cancelled)
                            {
                                <a asp-page="/Payments/CheckOut" asp-route-orderId="@o.OrderId" class="btn btn-sm btn-outline-success">Payment</a>
                            }
                            <a asp-page="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
