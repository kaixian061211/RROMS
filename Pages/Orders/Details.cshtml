@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = "Your order";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div><h1>Your order</h1></div>
    </header>

    @if (Model.Details is null)
    {
        <div class="alert alert-warning" role="alert">Order not found.</div>
        <a asp-page="Index" class="btn btn-outline-secondary">Back to my orders</a>
    }
    else
    {
        var order = Model.Details.Order;

        if (Model.StatusMessage is not null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <article class="rr-docket rr-docket--narrow" aria-label="Order @OrderFormatter.Reference(order.OrderId)">
            <div class="rr-docket__head">
                <div>
                    <span class="rr-docket__title">@OrderFormatter.Table(order.TableId)</span>
                    <span class="rr-ref d-block">@OrderFormatter.Reference(order.OrderId)</span>
                    <span class="small text-muted">Placed @OrderFormatter.PlacedAt(order.CreatedAt)</span>
                </div>
                <span class="@OrderFormatter.StatusBadge(order.Status)">@OrderFormatter.StatusLabel(order.Status)</span>
            </div>

            @* Where the order was when the page was opened. It doesn't update by itself. *@
            @if (order.Status != OrderStatus.Cancelled)
            {
                <ol class="rr-steps mb-4" aria-label="Order progress">
                    @foreach (var step in OrderFormatter.Steps)
                    {
                        var stepClass = OrderFormatter.StepClass(order.Status, step);
                        <li class="@stepClass" aria-current="@(stepClass == "is-current" ? "step" : null)">@OrderFormatter.StatusLabel(step)</li>
                    }
                </ol>
            }

            <ol class="rr-docket__lines">
                @foreach (var line in Model.Details.Lines)
                {
                    <li class="rr-docket__line">
                        <span class="rr-docket__qty">@line.Item.Quantity ×</span>
                        <span>
                            @line.MenuItemName
                            <span class="d-block small text-muted">@OrderFormatter.Money(line.Item.UnitPrice) each</span>
                        </span>
                        <span class="rr-docket__amount">@OrderFormatter.Money(line.Item.LineTotal)</span>
                    </li>
                }
            </ol>
            <div class="rr-docket__total">
                <span>Total</span>
                <span class="rr-money">@OrderFormatter.Money(order.Total)</span>
            </div>

            @* A cancelled order has nothing to pay. TODO: also hide it once the order is paid (Session 10). *@
            @if (order.Status != OrderStatus.Cancelled)
            {
                <div class="rr-docket__actions">
                    <a asp-page="/Payments/CheckOut" asp-route-orderId="@order.OrderId" class="btn btn-primary">Go to payment</a>
                </div>
            }
        </article>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-page="Create" class="btn btn-outline-secondary">Order more food</a>
            <a asp-page="Index" class="btn btn-outline-secondary">View my orders</a>
        </div>
    }
</div>
