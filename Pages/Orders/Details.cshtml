@page "{id:int}"
@model DetailsModel
@{
    ViewData["Title"] = "Order details";
}

@if (Model.Details is null)
{
    <div class="alert alert-warning" role="alert">Order not found.</div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to my orders</a>
}
else
{
    var order = Model.Details.Order;
    <div class="row">
        <div class="col-lg-8">
            @if (Model.StatusMessage is not null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @Model.StatusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h1 class="h3 mb-0">Order @OrderFormatter.Reference(order.OrderId)</h1>
                <span class="badge fs-6 @OrderFormatter.StatusBadge(order.Status)">@OrderFormatter.StatusLabel(order.Status)</span>
            </div>

            @* In a card, like a reservation's details on the Confirmation and Cancel pages. *@
            <div class="card mb-3">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Placed</dt>
                        <dd class="col-sm-8">@OrderFormatter.PlacedAt(order.CreatedAt)</dd>
                        <dt class="col-sm-4">Table</dt>
                        <dd class="col-sm-8">@OrderFormatter.Table(order.TableId)</dd>
                    </dl>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Dish</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit price</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.Details.Lines)
                                {
                                    <tr>
                                        <td>@line.MenuItemName</td>
                                        <td class="text-end">@line.Item.Quantity</td>
                                        <td class="text-end text-nowrap">@OrderFormatter.Money(line.Item.UnitPrice)</td>
                                        <td class="text-end text-nowrap">@OrderFormatter.Money(line.Item.LineTotal)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Total</th>
                                    <th class="text-end text-nowrap">@OrderFormatter.Money(order.Total)</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @* A cancelled order has nothing to pay. TODO: also hide it once the order is paid (Session 10). *@
                @if (order.Status != OrderStatus.Cancelled)
                {
                    <a asp-page="/Payments/CheckOut" asp-route-orderId="@order.OrderId" class="btn btn-success">Go to payment</a>
                }
                <a asp-page="Index" class="btn btn-primary">View my orders</a>
                <a asp-page="Create" class="btn btn-outline-secondary">Order more food</a>
            </div>
        </div>
    </div>
}
