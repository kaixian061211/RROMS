@page
@model CreateModel
@using System.Globalization
@{
    ViewData["Title"] = "Order food";
}

<div class="order-page">
    <header class="rr-page-header">
        <div>
            <h1>Order food</h1>
            <p class="rr-lede">Choose your table and your dishes. You pay after ordering, at the counter or online.</p>
        </div>
    </header>

    <form method="post" data-order-form>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        @if (Model.Menu.Count == 0)
        {
            <div class="alert alert-info" role="status">Sorry, nothing can be ordered right now.</div>
            <a asp-page="Index" class="btn btn-outline-secondary">Back to my orders</a>
        }
        else
        {
            <div class="row g-4 align-items-start">
                <div class="col-lg-8 col-xl-7">
                    @* Choice tiles: radio buttons drawn as tiles (see /Dev/StyleGuide). *@
                    <fieldset class="mb-4">
                        <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.Input.TableId)</legend>
                        @foreach (var area in ReservationFormatter.TablesByArea(Model.Tables))
                        {
                            <div class="rr-tile-group">
                                <span class="rr-label mb-2">@area.Key</span>
                                <div class="rr-tiles">
                                    @foreach (var table in area)
                                    {
                                        <input type="radio" class="btn-check" id="table-@table.TableId" name="Input.TableId" value="@table.TableId"
                                               checked="@(table.TableId == Model.Input.TableId)" required />
                                        <label class="rr-tile" for="table-@table.TableId">@table.TableNumber</label>
                                    }
                                </div>
                            </div>
                        }
                    </fieldset>
                        @{
                            var groupedMenu = Model.Menu
                                .Select((dish, index) => new { Dish = dish, Index = index })
                                .GroupBy(x => string.IsNullOrWhiteSpace(x.Dish.CategoryName) ? "Uncategorized" : x.Dish.CategoryName)
                                .OrderBy(g => g.FirstOrDefault()?.Dish.CategoryDisplayOrder ?? int.MaxValue);
                        }

                        @foreach (var group in groupedMenu)
                        {
                            <fieldset class="mb-4">
                                <legend class="form-label fs-6">@group.Key</legend>
                                <ul class="rr-dishes">
                                    @foreach (var item in group)
                                    {
                                        var i = item.Index;
                                        var dish = item.Dish;
                                var quantityId = $"quantity-{dish.MenuItemId}";
                                var isAvailable = dish.IsAvailable;

                                <li class="rr-dish @(!isAvailable ? "rr-dish--sold-out opacity-50" : "")" data-dish>
                                    <label for="@quantityId">
                                        <span class="rr-dish__name">@dish.Name</span>
                                        @if (!isAvailable)
                                        {
                                            <span class="badge bg-secondary ms-2">Sold out</span>
                                        }
                                        <span class="rr-dish__price">@OrderFormatter.Money(dish.Price)</span>
                                    </label>
                                    @* Only the dish id and quantity are form fields. data-price and data-name are for the docket on screen. *@
                                    <input type="hidden" name="Input.Items[@i].MenuItemId" value="@dish.MenuItemId" />

                                    @if (!isAvailable)
                                    {
                                        <input type="hidden" name="Input.Items[@i].Quantity" value="0" />
                                        <div class="rr-stepper" data-stepper>
                                            <button type="button" class="rr-stepper__button" disabled>&minus;</button>
                                            <input type="number" class="rr-stepper__input" id="@quantityId" value="0" disabled />
                                            <button type="button" class="rr-stepper__button" disabled>+</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rr-stepper" data-stepper>
                                            <button type="button" class="rr-stepper__button" data-step="-1" aria-label="One less @dish.Name">&minus;</button>
                                            <input type="number" class="rr-stepper__input" id="@quantityId" name="Input.Items[@i].Quantity"
                                                   value="@Model.Input.Items[i].Quantity" min="0" max="@OrderLineInput.MaxQuantity" step="1"
                                                   data-price="@dish.Price.ToString(CultureInfo.InvariantCulture)" data-name="@dish.Name" />
                                            <button type="button" class="rr-stepper__button" data-step="1" aria-label="One more @dish.Name">+</button>
                                        </div>
                                    }
                                </li>
                                    }
                                        </ul>
                                    </fieldset>
                                    }
                </div>

                <div class="col-lg-4 col-xl-5">
                    <aside class="rr-docket order-summary" aria-labelledby="your-order">
                        <div class="rr-docket__head">
                            <h2 class="rr-docket__title mb-0" id="your-order">Your order</h2>
                        </div>
                        @* Filled in by order-form.js as dishes are chosen. The real total is worked out on the server when the order is placed. *@
                        <div data-needs-script hidden>
                            <p class="text-muted mb-0" data-order-empty>Nothing chosen yet.</p>
                            <ol class="rr-docket__lines" data-order-lines></ol>
                            <div class="rr-docket__total">
                                <span>Total</span>
                                <span class="rr-money" data-order-total></span>
                            </div>
                        </div>
                        <div class="rr-docket__actions d-none d-lg-flex">
                            <button type="submit" class="btn btn-primary">Place order</button>
                        </div>
                        <p class="small mt-3 mb-0"><a asp-page="Index">Back to my orders</a></p>
                    </aside>
                </div>
            </div>

            @* Below 992px the Place order button is here instead, and on a phone it stays at the bottom of the screen. *@
            <div class="rr-actionbar d-lg-none">
                <span class="me-auto" data-needs-script hidden>
                    <span data-order-count></span> · <strong class="rr-money" data-order-total></strong>
                </span>
                <button type="submit" class="btn btn-primary">Place order</button>
            </div>
        }
    </form>
</div>

@section Scripts {
    <script src="~/js/stepper.js" asp-append-version="true"></script>
    <script src="~/js/order-form.js" asp-append-version="true"></script>
}