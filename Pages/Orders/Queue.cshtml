@page
@model QueueModel
@{
    ViewData["Title"] = "Order queue";
    // The board: with no filter, one column per active status (pending to served); with a filter, just that status.
    var columns = Model.StatusFilter is null ? OrderFormatter.Steps : new[] { Model.StatusFilter };
    var ordersByStatus = Model.Orders.ToLookup(item => item.Order.Status);
}

<header class="rr-page-header">
    <div>
        <h1>Order queue</h1>
        <p class="rr-lede">Oldest orders at the top of each column. New orders show up by themselves: the page reloads every 30 seconds.</p>
    </div>
</header>

@* Status filter: links, so one tap applies it and the choice is in the address. *@
<nav class="nav nav-pills mb-4" aria-label="Status">
    <a asp-page="Queue" class="nav-link @(Model.StatusFilter is null ? "active" : null)"
       aria-current="@(Model.StatusFilter is null ? "page" : null)">All active orders</a>
    @foreach (var status in OrderStatus.All)
    {
        <a asp-page="Queue" asp-route-status="@status" class="nav-link @(status == Model.StatusFilter ? "active" : null)"
           aria-current="@(status == Model.StatusFilter ? "page" : null)">@OrderFormatter.StatusFilterLabel(status)</a>
    }
</nav>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* The ticket rail: each column is a status, and its orders hang from the rail as dockets. *@
<div class="rr-board @(Model.StatusFilter is null ? null : "rr-board--single")">
    @foreach (var status in columns)
    {
        var orders = ordersByStatus[status].ToList();
        var label = OrderFormatter.StatusFilterLabel(status);
        <section class="rr-board__column" aria-label="@label">
            <h2 class="rr-board__title">@label <span class="rr-count">@orders.Count</span></h2>
            <div class="rr-board__rail"></div>
            @if (orders.Count == 0)
            {
                <p class="rr-board__empty">No orders.</p>
            }
            else
            {
                <div class="rr-board__dockets">
                    @foreach (var item in orders)
                    {
                        var order = item.Order;
                        <article class="rr-docket" aria-label="@OrderFormatter.Table(order.TableId), @OrderFormatter.Reference(order.OrderId)">
                            <div class="rr-docket__head">
                                <div>
                                    <span class="rr-docket__title">@OrderFormatter.Table(order.TableId)</span>
                                    <span class="rr-ref d-block">@OrderFormatter.Reference(order.OrderId)</span>
                                    <span class="small text-muted">@OrderFormatter.Time(order.CreatedAt) · @OrderFormatter.Waiting(order.CreatedAt)</span>
                                </div>
                            </div>
                            <ol class="rr-docket__lines">
                                @foreach (var line in item.Lines)
                                {
                                    <li class="rr-docket__line"><span class="rr-docket__qty">@line.Item.Quantity ×</span> <span>@line.MenuItemName</span></li>
                                }
                            </ol>
                            <div class="rr-docket__total">
                                <span>Total</span>
                                <span class="rr-money">@OrderFormatter.Money(order.Total)</span>
                            </div>
                            <div class="rr-docket__meta">
                                <span class="@OrderFormatter.PaymentBadge(item.Payment)">@OrderFormatter.PaymentLabel(item.Payment)</span>
                            </div>
                            @if (item.AllowedStatusChanges.Count > 0)
                            {
                                <div class="rr-docket__actions">
                                    @foreach (var next in item.AllowedStatusChanges)
                                    {
                                        <form method="post" asp-page-handler="ChangeStatus" asp-route-status="@Model.StatusFilter">
                                            <input type="hidden" name="id" value="@order.OrderId" />
                                            <input type="hidden" name="newStatus" value="@next" />
                                            <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(order.RowVersion)" />
                                            <button type="submit" class="btn btn-sm @OrderFormatter.StatusActionButton(next)"
                                                    onclick="@(next == OrderStatus.Cancelled ? "return confirm('Cancel this order?');" : null)">
                                                @OrderFormatter.StatusAction(next)
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@section Scripts {
    <script>
        // New orders show up without pressing anything: reload the queue every 30 seconds.
        setTimeout(function () { window.location.reload(); }, 30000);
    </script>
}
