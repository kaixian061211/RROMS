@page
@model RROMS.Web.Pages.Promotions.Manage.EditModel
@using RROMS.Web.Models.Payments
@using RROMS.Web.Models.Restaurant
@{
    var editing = Model.Input.PromotionId != 0;
    ViewData["Title"] = editing ? "Edit promotion" : "Add promotion";
}

<header class="rr-page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="rr-lede">Customers see the lower price on the menu while the promotion is running.</p>
    </div>
    <div class="rr-page-actions">
        <a asp-page="/Promotions/Manage/Index" class="btn btn-outline-secondary">Back to promotions</a>
    </div>
</header>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="rr-panel mb-4">
        <input type="hidden" asp-for="Input.PromotionId" />

        <div class="mb-4">
            <label asp-for="Input.Title" class="form-label">Title</label>
            <input asp-for="Input.Title" class="form-control" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.Description" class="form-label">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>

        <fieldset class="mb-4">
            <legend class="form-label fs-6">Discount type</legend>
            <div class="rr-tiles rr-tiles--wide">
                <input type="radio" class="btn-check" id="type-percentage" name="Input.DiscountType" value="Percentage"
                       checked="@(Model.Input.DiscountType == DiscountType.Percentage)" />
                <label class="rr-tile" for="type-percentage">Percentage off</label>
                <input type="radio" class="btn-check" id="type-fixed" name="Input.DiscountType" value="FixedAmount"
                       checked="@(Model.Input.DiscountType == DiscountType.FixedAmount)" />
                <label class="rr-tile" for="type-fixed">Amount off (RM)</label>
            </div>
        </fieldset>

        <div class="mb-4">
            <label asp-for="Input.DiscountValue" class="form-label">Discount (% or RM, depending on the type)</label>
            <input asp-for="Input.DiscountValue" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Input.DiscountValue" class="text-danger"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Input.StartDate" class="form-label">First day</label>
                <input asp-for="Input.StartDate" type="date" class="form-control" />
                <span asp-validation-for="Input.StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.EndDate" class="form-label">Last day</label>
                <input asp-for="Input.EndDate" type="date" class="form-control" />
                <span asp-validation-for="Input.EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="BannerFile" class="form-label">Banner picture (optional)</label>
            @if (!string.IsNullOrEmpty(Model.BannerPath))
            {
                <div class="mb-2"><img class="preview" src="@Model.BannerPath" alt="Current banner" /></div>
            }
            <input asp-for="BannerFile" type="file" class="form-control" accept="image/*" />
            <div class="form-text">JPG, PNG, WEBP or GIF, up to 2 MB.</div>
            <span asp-validation-for="BannerFile" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="Input.IsActive" class="form-check-input" />
            <label asp-for="Input.IsActive" class="form-check-label">Switched on (untick to pause it without deleting)</label>
        </div>
    </div>

    <div class="rr-panel">
        <fieldset>
            <legend class="h3 mb-3">Dishes it applies to</legend>

            @if (Model.AllMenuItems.Any())
            {
                @foreach (var item in Model.AllMenuItems)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="SelectedMenuItemIds" value="@item.MenuItemId" id="dish-@item.MenuItemId"
                               checked="@Model.SelectedMenuItemIds.Contains(item.MenuItemId)" />
                        <label class="form-check-label" for="dish-@item.MenuItemId">
                            @item.Name <span class="text-muted">· @PaymentFormatter.Money(item.Price)</span>
                        </label>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">There are no dishes yet. <a asp-page="/Menu/Manage/Edit">Add a menu item</a> first.</p>
            }

            <span asp-validation-for="SelectedMenuItemIds" class="text-danger d-block mt-2"></span>
        </fieldset>
    </div>

    <div class="rr-actionbar">
        <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Add promotion")</button>
        <a asp-page="/Promotions/Manage/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
