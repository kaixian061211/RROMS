@page
@model RROMS.Web.Pages.Menu.Manage.EditModel
@{
    var editing = Model.Input.MenuItemId != 0;
    ViewData["Title"] = editing ? "Edit menu item" : "Add menu item";
}

<header class="rr-page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="rr-lede">What customers see on the menu.</p>
    </div>
    <div class="rr-page-actions">
        <a asp-page="/Menu/Manage/Index" class="btn btn-outline-secondary">Back to menu</a>
    </div>
</header>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="rr-panel">
        <input type="hidden" asp-for="Input.MenuItemId" />

        <div class="mb-4">
            <label asp-for="Input.Name" class="form-label">Name</label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.Description" class="form-label">Description</label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="Input.Price" class="form-label">Price (RM)</label>
                <input asp-for="Input.Price" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.MenuCategoryId" class="form-label">Category (optional)</label>
                <select asp-for="Input.MenuCategoryId" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">No category</option>
                </select>
                <span asp-validation-for="Input.MenuCategoryId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="ImageFile" class="form-label">Picture (optional)</label>
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-2"><img class="thumb" src="@Model.ImagePath" alt="Current picture" /></div>
            }
            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            <div class="form-text">JPG, PNG, WEBP or GIF, up to 2 MB.@(editing ? " Choose a file only to replace the current picture." : "")</div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="Input.IsAvailable" class="form-check-input" />
            <label asp-for="Input.IsAvailable" class="form-check-label">Available to order (untick to show as sold out)</label>
        </div>
    </div>

    <div class="rr-actionbar">
        <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Add to menu")</button>
        <a asp-page="/Menu/Manage/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
