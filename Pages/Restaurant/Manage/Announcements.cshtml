@page
@model RROMS.Web.Pages.Restaurant.Manage.AnnouncementsModel
@using RROMS.Web.Models.Payments
@using RROMS.Web.Models.Restaurant
@{
    ViewData["Title"] = "Announcements";
    var editing = Model.Input.AnnouncementId != 0;
    var now = DateTime.Now;
}

<header class="rr-page-header">
    <div>
        <h1>Announcements</h1>
        <p class="rr-lede">Messages customers see on the restaurant page, such as holiday hours or a closed day.</p>
    </div>
    <div class="rr-page-actions">
        <a asp-page="/Restaurant/Manage/Details" class="btn btn-outline-secondary">Restaurant details</a>
    </div>
</header>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <form method="post" asp-page-handler="Save">
            <div class="rr-panel">
                <h2 class="h3 mb-4">@(editing ? "Edit announcement" : "New announcement")</h2>

                <input type="hidden" asp-for="Input.AnnouncementId" />

                <div class="mb-4">
                    <label asp-for="Input.Title" class="form-label">Title</label>
                    <input asp-for="Input.Title" class="form-control" />
                    <span asp-validation-for="Input.Title" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Message" class="form-label">Message</label>
                    <textarea asp-for="Input.Message" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Message" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ExpiresAt" class="form-label">Hide after (optional)</label>
                    <input asp-for="Input.ExpiresAt" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Input.ExpiresAt" class="text-danger"></span>
                </div>

                <div class="form-check">
                    <input asp-for="Input.IsActive" class="form-check-input" />
                    <label asp-for="Input.IsActive" class="form-check-label">Show to customers</label>
                </div>
            </div>

            <div class="rr-actionbar">
                <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Post announcement")</button>
                @if (editing)
                {
                    <a asp-page="/Restaurant/Manage/Announcements" class="btn btn-outline-secondary">Cancel</a>
                }
            </div>
        </form>
    </div>

    <div class="col-lg-7">
        @if (Model.Announcements.Any())
        {
            <h2 class="rr-group-title">All announcements <span class="rr-count">@Model.Announcements.Count</span></h2>
            <ul class="rr-list">
                @foreach (var announcement in Model.Announcements)
                {
                    var status = RestaurantFormatter.AnnouncementStatus(announcement, now);
                    <li class="rr-list__item">
                        <div class="rr-list__main">
                            <div class="fw-semibold">@announcement.Title</div>
                            <p class="small text-muted mt-1 mb-0">@announcement.Message</p>
                            <span class="small text-muted">Posted @PaymentFormatter.When(announcement.CreatedAt)@(announcement.ExpiresAt is null ? "" : " · Hidden after " + PaymentFormatter.When(announcement.ExpiresAt))</span>
                        </div>
                        <span class="rr-status @status.Css">@status.Label</span>
                        <div class="rr-list__actions">
                            <a asp-page="/Restaurant/Manage/Announcements" asp-route-id="@announcement.AnnouncementId" class="btn btn-sm btn-outline-secondary">Edit<span class="visually-hidden"> @announcement.Title</span></a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@announcement.AnnouncementId" class="d-inline"
                                  onsubmit="return confirm('Delete this announcement?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete<span class="visually-hidden"> @announcement.Title</span></button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="rr-empty">
                <p class="rr-empty__title">No announcements yet</p>
                <p class="mb-0">Post one and it will appear on the restaurant page for customers.</p>
            </div>
        }
    </div>
</div>
