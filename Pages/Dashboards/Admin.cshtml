@page
@model RROMS.Web.Pages.Dashboards.AdminModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<header class="rr-page-header">
    <div>
        <span class="rr-label">Admin</span>
        <h1>Welcome, @User.Identity?.Name</h1>
        <p class="rr-lede">Set up the restaurant, manage accounts and see how it's doing.</p>
    </div>
</header>

<h2 class="rr-group-title">Restaurant and accounts</h2>
<partial name="_Cards" model="Model.Cards" />

<h2 class="rr-group-title mt-5">Daily operations</h2>
<partial name="_Cards" model="Model.Operations" />
