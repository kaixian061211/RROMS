@page
@model RROMS.Web.Pages.Dashboards.AdminModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<header class="rr-page-header">
    <div>
        <span class="rr-label">Admin</span>
        <h1>Dashboard</h1>
    </div>
</header>

<partial name="_Cards" model="Model" />

<!-- Menu Management Links -->
<div class="mt-4">
    <h2 class="h4 mb-3">Menu Management</h2>
    <div class="d-flex gap-2">
        <a asp-page="/Menu/Manage/Index" class="btn btn-primary">
            Manage Menu Items
        </a>
        <a asp-page="/Menu/Manage/Categories" class="btn btn-outline-primary">
            Manage Categories
        </a>
    </div>
</div>
<!-- Restaurant Management Links -->
<div class="mt-4">
    <h2 class="h4 mb-3">Restaurant Management</h2>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Restaurant/Manage/DiningAreas"
           class="btn btn-primary">
            Manage Dining Areas
        </a>

        <a asp-page="/Restaurant/Manage/Tables"
           class="btn btn-outline-primary">
            Manage Tables
        </a>
    </div>
</div>