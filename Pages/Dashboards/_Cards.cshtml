@model IReadOnlyList<RROMS.Web.Models.Dashboards.DashboardCard>
@* A role's features as a shelf of links (rr-shelf, each one an rr-feature), in story order. Features that
   aren't built yet follow in a quieter row: "Coming soon" buttons that do nothing when clicked. *@
@{
    var built = Model.Where(card => card.IsBuilt).ToList();
    var soon = Model.Where(card => !card.IsBuilt).ToList();
}

<div class="rr-shelf">
    <div class="rr-shelf__sheet">
        <ul class="rr-shelf__list">
            @foreach (var card in built)
            {
                <li class="rr-feature">
                    @* The link covers the whole cell (rr-feature__title a::after). *@
                    <h3 class="rr-feature__title"><a href="@card.PagePath">@card.Title</a></h3>
                    <p class="rr-feature__meta">@card.Description</p>
                </li>
            }
        </ul>
    </div>
    @if (soon.Count > 0)
    {
        <div class="rr-shelf__soon">
            @foreach (var card in soon)
            {
                <button type="button" class="rr-feature rr-feature--soon" title="@card.Description">
                    <span class="rr-feature__title">@card.Title</span>
                    <span class="rr-soon">Coming soon</span>
                </button>
            }
        </div>
    }
</div>
