@model IReadOnlyList<RROMS.Web.Models.Dashboards.DashboardCard>
@* A grid of feature cards (rr-feature). A built feature links to its page; one that isn't built yet is a
   "Coming soon" placeholder: a button that does nothing when clicked. *@

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
    @foreach (var card in Model)
    {
        <div class="col">
            @if (card.IsBuilt)
            {
                <div class="rr-feature">
                    @* The link covers the whole card (rr-feature__title a::after). *@
                    <h2 class="rr-feature__title"><a href="@card.PagePath">@card.Title</a></h2>
                    <p class="text-muted mb-0">@card.Description</p>
                </div>
            }
            else
            {
                <button type="button" class="rr-feature rr-feature--soon">
                    <span class="rr-feature__title">@card.Title</span>
                    <span class="text-muted">@card.Description</span>
                    <span class="rr-soon mt-3">Coming soon</span>
                </button>
            }
        </div>
    }
</div>
