@* Who the Development test login has signed in. The layout shows this only in Development. *@
@using System.Security.Claims
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var roles = string.Join(", ", User.FindAll(ClaimTypes.Role).Select(claim => claim.Value));
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}
<div class="test-user-bar rr-devbar">
    <div class="container-xxl d-flex flex-wrap align-items-center column-gap-3 row-gap-1 py-1">
        <span class="rr-devbar__tag">TEST LOGIN · DEVELOPMENT ONLY</span>
        @if (signedIn)
        {
            <span>Signed in as <strong>@User.Identity!.Name</strong> · @roles · user #@userId</span>
        }
        else
        {
            <span>Not signed in</span>
        }
        <span class="ms-auto d-flex gap-3">
            <a asp-page="/Dev/StyleGuide">Style guide</a>
            <a asp-page="/Dev/SwitchUser">@(signedIn ? "Switch user" : "Choose a test user")</a>
        </span>
    </div>
</div>
