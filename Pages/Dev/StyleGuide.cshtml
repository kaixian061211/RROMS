@section Scripts {
    <script>
        // Makes the example stepper work. The real pages use wwwroot/js/order-form.js.
        document.querySelectorAll('[data-sg-stepper]').forEach(function (stepper) {
            const input = stepper.querySelector('input');
            stepper.querySelectorAll('[data-step]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const value = (Number(input.value) || 0) + Number(button.dataset.step);
                    input.value = Math.min(Math.max(value, Number(input.min)), Number(input.max));
                });
            });
        });
    </script>
}
