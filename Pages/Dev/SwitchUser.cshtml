@page
@model RROMS.Web.Pages.Dev.SwitchUserModel
@using RROMS.Web.Services.Payments
@{
    ViewData["Title"] = "Switch test user";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentId = User.TryGetPaymentUserId(out var id) ? id : (int?)null;
}

<h1 class="h3">Switch test user</h1>
<p class="text-muted">Development only. Sign in as a test user to try the pages as that role. The real login replaces this page.</p>

@if (Model.ReturnUrl is not null)
{
    <div class="alert alert-warning" role="alert">
        @if (signedIn)
        {
            <text><strong>@User.Identity!.Name</strong> can't open <code>@Model.ReturnUrl</code>. Choose a user who can.</text>
        }
        else
        {
            <text>Choose a test user to open <code>@Model.ReturnUrl</code>.</text>
        }
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
    @foreach (var user in Model.Users)
    {
        var current = signedIn && currentId == user.Id;
        <div class="col">
            <form method="post" asp-page-handler="SignIn" class="h-100">
                <input type="hidden" name="id" value="@user.Id" />
                <button type="submit" class="btn @(current ? "btn-primary" : "btn-outline-primary") w-100 h-100 py-3 d-flex flex-column align-items-start text-start">
                    <span class="d-block fw-semibold">@user.Name</span>
                    <span class="d-block small">@user.Role · user #@user.Id</span>
                    @if (current)
                    {
                        <span class="badge text-bg-light mt-2">Signed in</span>
                    }
                </button>
            </form>
        </div>
    }
</div>

@if (signedIn)
{
    <form method="post" asp-page-handler="SignOut">
        <button type="submit" class="btn btn-outline-secondary">Sign out</button>
    </form>
}
