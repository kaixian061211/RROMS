@page
@model RROMS.Web.Pages.Dev.SwitchUserModel
@using RROMS.Web.Services.Payments
@{
    ViewData["Title"] = "Switch user";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentId = User.TryGetPaymentUserId(out var id) ? id : (int?)null;
}

<header class="rr-page-header">
    <div>
        <span class="rr-label">Development only</span>
        <h1>Switch user</h1>
        <p class="rr-lede">Sign in as any active account in this database without its password, to try the pages as that person.</p>
    </div>
</header>

@if (Model.ReturnUrl is not null)
{
    <div class="alert alert-warning" role="alert">
        @if (signedIn)
        {
            <text><strong>@User.Identity!.Name</strong> can't open <code>@Model.ReturnUrl</code>. Choose a user who can.</text>
        }
        else
        {
            <text>Choose a user to open <code>@Model.ReturnUrl</code>.</text>
        }
    </div>
}

@if (Model.Accounts.Count == 0)
{
    <p class="text-muted">No active accounts yet. Register one at <a asp-page="/Account/Register">Register</a>.</p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
        @foreach (var account in Model.Accounts)
        {
            var current = signedIn && currentId == account.UserId;
            <div class="col">
                <form method="post" asp-page-handler="SignIn" class="h-100">
                    <input type="hidden" name="id" value="@account.UserId" />
                    <button type="submit" class="rr-feature @(current ? "is-current" : null)">
                        <span class="rr-feature__title d-block">@account.FullName</span>
                        <span class="d-block text-muted">@account.Role · user #@account.UserId</span>
                        <span class="d-block text-muted small text-break">@account.Email</span>
                        @if (current)
                        {
                            <span class="rr-status rr-status--good mt-2">Signed in</span>
                        }
                    </button>
                </form>
            </div>
        }
    </div>
}

@if (signedIn)
{
    <form method="post" asp-page-handler="SignOut">
        <button type="submit" class="btn btn-outline-secondary">Sign out</button>
    </form>
}
