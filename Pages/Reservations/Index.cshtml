@page
@model IndexModel
@{
    ViewData["Title"] = "My reservations";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>My reservations</h1>
            <p class="rr-lede">Your upcoming bookings, soonest first.</p>
        </div>
        @if (Model.Reservations.Count > 0)
        {
            <div class="rr-page-actions">
                <a asp-page="Create" class="btn btn-primary">Book a table</a>
            </div>
        }
    </header>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Reservations.Count == 0)
    {
        <div class="rr-empty">
            <p class="rr-empty__title">You have no upcoming reservations.</p>
            <p class="mb-0">Book a table and it will show up here.</p>
            <a asp-page="Create" class="btn btn-primary">Book a table</a>
        </div>
    }
    else
    {
        <ul class="list-unstyled d-grid gap-3 mb-0">
            @foreach (var r in Model.Reservations)
            {
                var reference = ReservationFormatter.Reference(r.ReservationId);
                <li class="rr-slip">
                    <partial name="_DateBlock" model="r.ReservationDate" />
                    <div class="rr-slip__body">
                        <div>
                            <div class="rr-slip__title">
                                @ReservationFormatter.Time(r.TimeSlot) · @ReservationFormatter.Table(r.TableId, Model.Tables) · @ReservationFormatter.PartySize(r.PartySize)
                            </div>
                            <span class="rr-ref">@reference</span>
                            @if (r.SpecialRequest is not null)
                            {
                                <p class="small text-muted mt-1 mb-0">@r.SpecialRequest</p>
                            }
                        </div>
                        <div class="rr-slip__side">
                            <span class="@ReservationFormatter.StatusBadge(r.Status)">@ReservationFormatter.StatusLabel(r.Status)</span>
                            @* The hidden reference tells a screen reader which booking each button is for. *@
                            <div class="d-flex gap-2">
                                <a asp-page="Edit" asp-route-id="@r.ReservationId" class="btn btn-sm btn-outline-secondary">Change<span class="visually-hidden"> @reference</span></a>
                                <a asp-page="Cancel" asp-route-id="@r.ReservationId" class="btn btn-sm btn-outline-danger">Cancel<span class="visually-hidden"> @reference</span></a>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>
