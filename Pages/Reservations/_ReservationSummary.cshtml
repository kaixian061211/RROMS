@* A reservation as a docket, shown on the Confirmation and Cancel pages. *@
@model Reservation
@{
    var tables = ViewData["Tables"] as IReadOnlyDictionary<int, TableInfo> ?? new Dictionary<int, TableInfo>();
}

<article class="rr-docket rr-docket--narrow" aria-label="Booking @ReservationFormatter.Reference(Model.ReservationId)">
    <div class="rr-docket__head">
        <div>
            <span class="rr-docket__title">@ReservationFormatter.When(Model.ReservationDate, Model.TimeSlot)</span>
            <span class="d-block fw-semibold mt-1">@ReservationFormatter.Table(Model.TableId, tables) · @ReservationFormatter.PartySize(Model.PartySize)</span>
        </div>
        <span class="@ReservationFormatter.StatusBadge(Model.Status)">@ReservationFormatter.StatusLabel(Model.Status)</span>
    </div>

    @if (Model.SpecialRequest is not null)
    {
        <span class="rr-label">Special request</span>
        <p class="mb-0">@Model.SpecialRequest</p>
    }

    <div class="rr-docket__total">
        <span>Reference</span>
        <span class="rr-ref">@ReservationFormatter.Reference(Model.ReservationId)</span>
    </div>
</article>
