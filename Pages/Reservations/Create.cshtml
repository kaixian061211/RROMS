@page
@model CreateModel
@{
    ViewData["Title"] = "Book a table";
    ViewData["Tables"] = Model.Tables;   // for the partials below
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <h1>Book a table</h1>
            <p class="rr-lede">Pick a day, a time and a table. Your booking is pending until the restaurant confirms it.</p>
        </div>
    </header>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="rr-panel">
            <partial name="_ReservationFields" for="Input" />
        </div>
        <div class="rr-actionbar">
            <button type="submit" class="btn btn-primary">Book table</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Back<span class="d-none d-sm-inline"> to my reservations</span></a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/stepper.js" asp-append-version="true"></script>
}
