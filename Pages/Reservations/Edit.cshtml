@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Change reservation";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <span class="rr-ref d-block mb-1">@ReservationFormatter.Reference(Model.Id)</span>
            <h1>Change reservation</h1>
        </div>
    </header>

    @if (Model.BlockedMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.BlockedMessage</div>
        <a asp-page="Index" class="btn btn-outline-secondary">Back to my reservations</a>
    }
    else
    {
        if (Model.IsConfirmed)
        {
            <div class="alert alert-info" role="status">
                This booking is confirmed. If you change the date, time, table or party size, the restaurant will need to confirm it again.
            </div>
        }
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="RowVersion" />
            <div class="rr-panel">
                <partial name="_ReservationFields" for="Input" />
            </div>
            <div class="rr-actionbar">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Back<span class="d-none d-sm-inline"> to my reservations</span></a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/stepper.js" asp-append-version="true"></script>
}
