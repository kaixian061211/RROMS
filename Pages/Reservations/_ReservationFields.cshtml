@* The form fields shared by the Create and Edit pages. Used as <partial name="_ReservationFields" for="Input" />.
   The time and table are choice tiles: radio buttons drawn as tiles (see /Dev/StyleGuide). The party size is a
   stepper, so the page needs wwwroot/js/stepper.js. *@
@using System.Globalization
@model ReservationInput
@{
    // The page's tables (ViewData["Tables"]); the tiles offer the active ones.
    var tables = ViewData["Tables"] as IReadOnlyDictionary<int, TableInfo> ?? new Dictionary<int, TableInfo>();
}

<div class="mb-4">
    <label asp-for="ReservationDate" class="form-label"></label>
    @* min stops the date picker offering past dates; data-msg-min is the browser check's message for one typed in. *@
    <input asp-for="ReservationDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control"
           min="@ReservationFormatter.InputDate(DateOnly.FromDateTime(DateTime.Today))"
           data-msg-min="Please choose a date and time in the future." />
    <span asp-validation-for="ReservationDate" class="text-danger"></span>
</div>

@* required makes the browser check ask for a choice; the service checks it again (TableId 0 or an unknown time). *@
<fieldset class="mb-4">
    <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.TimeSlot)</legend>
    @foreach (var (meal, slots) in new[] { ("Lunch", ReservationTimeSlots.Lunch), ("Dinner", ReservationTimeSlots.Dinner) })
    {
        <div class="rr-tile-group">
            <span class="rr-label mb-2">@meal</span>
            <div class="rr-tiles rr-tiles--wide">
                @foreach (var slot in slots)
                {
                    var tileId = $"{Html.IdFor(m => m.TimeSlot)}_{slot.ToString("HHmm", CultureInfo.InvariantCulture)}";
                    <input type="radio" class="btn-check" id="@tileId" name="@Html.NameFor(m => m.TimeSlot)"
                           value="@slot.ToString("HH:mm", CultureInfo.InvariantCulture)" checked="@(slot == Model.TimeSlot)"
                           required data-msg-required="Please choose a time." />
                    <label class="rr-tile" for="@tileId">@ReservationFormatter.Time(slot)</label>
                }
            </div>
        </div>
    }
    <span asp-validation-for="TimeSlot" class="text-danger"></span>
</fieldset>

<fieldset class="mb-4">
    <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.TableId)</legend>
    @foreach (var area in ReservationFormatter.TablesByArea(tables))
    {
        <div class="rr-tile-group">
            <span class="rr-label mb-2">@area.Key</span>
            <div class="rr-tiles">
                @foreach (var table in area)
                {
                    var tileId = $"{Html.IdFor(m => m.TableId)}_{table.TableId}";
                    <input type="radio" class="btn-check" id="@tileId" name="@Html.NameFor(m => m.TableId)" value="@table.TableId"
                           checked="@(table.TableId == Model.TableId)" required data-msg-required="Please choose a table." />
                    <label class="rr-tile" for="@tileId">
                        @table.TableNumber
                        @* The tile's own colour, faded, so it still shows on a chosen (green) tile. *@
                        <span class="d-block small text-nowrap opacity-75">@ReservationFormatter.Seats(table.Capacity)</span>
                    </label>
                }
            </div>
        </div>
    }
    @if (!tables.Values.Any(t => t.IsActive))
    {
        <p class="text-muted mb-0">No tables can be booked right now.</p>
    }
    <span asp-validation-for="TableId" class="text-danger"></span>
</fieldset>

<div class="mb-4">
    <label asp-for="PartySize" class="form-label d-block"></label>
    <div class="rr-stepper" data-stepper>
        <button type="button" class="rr-stepper__button" data-step="-1" aria-label="One person fewer">&minus;</button>
        <input asp-for="PartySize" class="rr-stepper__input" min="1" data-msg-min="Party size must be at least 1." />
        <button type="button" class="rr-stepper__button" data-step="1" aria-label="One person more">+</button>
    </div>
    <span asp-validation-for="PartySize" class="text-danger"></span>
</div>

<div>
    <label asp-for="SpecialRequest" class="form-label"></label>
    <textarea asp-for="SpecialRequest" class="form-control" rows="3" maxlength="500"
              placeholder="For example: a high chair, or a table by the window"></textarea>
    <span asp-validation-for="SpecialRequest" class="text-danger"></span>
</div>
