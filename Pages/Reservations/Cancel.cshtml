@page "{id:int}"
@model CancelModel
@{
    ViewData["Title"] = "Cancel reservation";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <span class="rr-ref d-block mb-1">@ReservationFormatter.Reference(Model.Id)</span>
            @if (Model.Reservation is not null && Model.ErrorMessage is null)
            {
                <h1>Cancel this reservation?</h1>
                <p class="rr-lede">The table is freed for that time. You can't undo this.</p>
            }
            else
            {
                <h1>Cancel reservation</h1>
            }
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        <a asp-page="Index" class="btn btn-outline-secondary">Back to my reservations</a>
    }
    else if (Model.Reservation is not null)
    {
        <partial name="_ReservationSummary" model="Model.Reservation" />
        <form method="post" class="d-flex flex-wrap gap-2 mt-4">
            <input type="hidden" asp-for="RowVersion" />
            <button type="submit" class="btn btn-danger">Yes, cancel it</button>
            <a asp-page="Index" class="btn btn-outline-secondary">No, keep it</a>
        </form>
    }
</div>
