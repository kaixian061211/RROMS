@page "{id:int}"
@model CancelModel
@{
    ViewData["Title"] = "Cancel reservation";
}

<h1 class="h3 mb-3">Cancel reservation</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to my reservations</a>
}
else if (Model.Reservation is not null)
{
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <p>Are you sure you want to cancel this reservation?</p>
            <partial name="_ReservationSummary" model="Model.Reservation" />
            <form method="post" class="d-flex flex-wrap gap-2 mt-3">
                <input type="hidden" asp-for="RowVersion" />
                <button type="submit" class="btn btn-danger">Yes, cancel it</button>
                <a asp-page="Index" class="btn btn-outline-secondary">No, keep it</a>
            </form>
        </div>
    </div>
}
