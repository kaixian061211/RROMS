@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Edit reservation";
}

<div class="rr-narrow">
    <header class="rr-page-header">
        <div>
            <span class="rr-ref d-block mb-1">@ReservationFormatter.Reference(Model.Id)</span>
            <h1>Edit reservation</h1>
            @if (Model.Reservation is not null)
            {
                <p class="rr-lede d-flex flex-wrap align-items-center gap-2">
                    @ReservationFormatter.Customer(Model.Reservation.CustomerUserId)
                    <span class="@ReservationFormatter.StatusBadge(Model.Reservation.Status)">@ReservationFormatter.StatusLabel(Model.Reservation.Status)</span>
                </p>
            }
        </div>
    </header>

    @if (Model.BlockedMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.BlockedMessage</div>
        <a asp-page="@(Model.FromUpcoming ? "Upcoming" : "Index")" class="btn btn-outline-secondary">Back to reservations</a>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="RowVersion" />
            @if (Model.From is not null)
            {
                <input type="hidden" name="from" value="@Model.From" />
            }
            <div class="rr-panel">
                <partial name="_ReservationFields" for="Input" />
            </div>
            <div class="rr-actionbar">
                <button type="submit" class="btn btn-primary">Save changes</button>
                @* With no date (left empty), the link goes to today's list. *@
                @if (Model.FromUpcoming)
                {
                    <a asp-page="Upcoming" class="btn btn-outline-secondary">Back to reservations</a>
                }
                else
                {
                    <a asp-page="Index" asp-route-date="@(Model.Input.ReservationDate is { } date ? ReservationFormatter.InputDate(date) : null)"
                       class="btn btn-outline-secondary">Back to reservations</a>
                }
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/stepper.js" asp-append-version="true"></script>
}
