@page
@model IndexModel
@{
    ViewData["Title"] = "Manage reservations";
    var dateValue = ReservationFormatter.InputDate(Model.SelectedDate);
}

<h1 class="h3 mb-3">Manage reservations</h1>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-sm-auto">
        <label for="date" class="form-label">Date</label>
        <input id="date" name="date" type="date" class="form-control" value="@dateValue" />
    </div>
    <div class="col-12 col-sm-auto">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var status in ReservationStatus.All)
            {
                <option value="@status" selected="@(status == Model.StatusFilter)">@ReservationFormatter.StatusLabel(status)</option>
            }
        </select>
    </div>
    <div class="col-12 col-sm-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Show</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Today</a>
    </div>
</form>

<h2 class="h5 mb-3">@ReservationFormatter.LongDate(Model.SelectedDate)</h2>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="text-center text-muted border rounded py-5">
        @(Model.StatusFilter is null ? "No reservations for this date." : "No reservations with this status for this date.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Time</th>
                    @* On phones (below md) these columns are hidden, and the Time cell shows their details instead. *@
                    <th class="d-none d-md-table-cell">Table</th>
                    <th class="d-none d-md-table-cell">Party size</th>
                    <th class="d-none d-md-table-cell">Customer</th>
                    <th class="d-none d-md-table-cell">Special request</th>
                    <th class="d-none d-md-table-cell">Status</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var r = row.Reservation;
                    <tr>
                        <td>
                            <span class="text-nowrap">@ReservationFormatter.Time(r.TimeSlot)</span>
                            <div class="small text-muted">@ReservationFormatter.Reference(r.ReservationId)</div>
                            <div class="small d-md-none">
                                @ReservationFormatter.Table(r.TableId) · @ReservationFormatter.PartySize(r.PartySize) · @ReservationFormatter.Customer(r.CustomerUserId)
                            </div>
                            @if (r.SpecialRequest is not null)
                            {
                                <div class="small fst-italic d-md-none">@r.SpecialRequest</div>
                            }
                            <span class="d-md-none @ReservationFormatter.StatusBadge(r.Status)">@ReservationFormatter.StatusLabel(r.Status)</span>
                        </td>
                        <td class="text-nowrap d-none d-md-table-cell">@ReservationFormatter.Table(r.TableId)</td>
                        <td class="text-nowrap d-none d-md-table-cell">@ReservationFormatter.PartySize(r.PartySize)</td>
                        <td class="text-nowrap d-none d-md-table-cell">@ReservationFormatter.Customer(r.CustomerUserId)</td>
                        <td class="d-none d-md-table-cell">@(r.SpecialRequest ?? "-")</td>
                        <td class="d-none d-md-table-cell"><span class="@ReservationFormatter.StatusBadge(r.Status)">@ReservationFormatter.StatusLabel(r.Status)</span></td>
                        <td>
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                @foreach (var next in row.NextStatuses)
                                {
                                    <form method="post" asp-page-handler="ChangeStatus" asp-route-date="@dateValue" asp-route-status="@Model.StatusFilter">
                                        <input type="hidden" name="id" value="@r.ReservationId" />
                                        <input type="hidden" name="newStatus" value="@next" />
                                        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(r.RowVersion)" />
                                        <button type="submit" class="btn btn-sm @ReservationFormatter.StatusActionButton(next)"
                                                onclick="@(next == ReservationStatus.Cancelled ? "return confirm('Cancel this reservation?');" : null)">
                                            @ReservationFormatter.StatusAction(next)
                                        </button>
                                    </form>
                                }
                                @if (row.CanEdit)
                                {
                                    <a asp-page="Edit" asp-route-id="@r.ReservationId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
