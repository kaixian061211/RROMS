@page
@model IndexModel
@{
    ViewData["Title"] = "Manage reservations";
    ViewData["Tables"] = Model.Tables;   // for the partials below
    var dateValue = ReservationFormatter.InputDate(Model.SelectedDate);
    var isToday = Model.SelectedDate == DateOnly.FromDateTime(DateTime.Today);

    // The row's status buttons come back to this day and filter.
    var routeValues = new Dictionary<string, string> { ["date"] = dateValue };
    if (Model.StatusFilter is not null)
        routeValues["status"] = Model.StatusFilter;
    var rowViewData = new ViewDataDictionary(ViewData) { ["RouteValues"] = routeValues };
}

<header class="rr-page-header">
    <div>
        <h1>Manage reservations</h1>
        <p class="rr-lede">
            <strong class="text-body">@ReservationFormatter.LongDate(Model.SelectedDate)</strong>@(isToday ? " (today)" : "")
            @if (Model.StatusFilter is null && Model.Rows.Count > 0)
            {
                <span class="d-block">@ReservationFormatter.DaySummary(Model.Rows.Select(row => row.Reservation))</span>
            }
        </p>
    </div>

    @* The day: the arrows go one day back or forward, keeping the status filter. *@
    <form method="get" class="d-flex flex-wrap align-items-center gap-2" aria-label="Choose a day">
        <a asp-page="Index" asp-route-date="@ReservationFormatter.InputDate(Model.SelectedDate.AddDays(-1))" asp-route-status="@Model.StatusFilter"
           class="btn btn-outline-secondary" aria-label="Previous day">&lsaquo;</a>
        <label for="date" class="visually-hidden">Date</label>
        <input id="date" name="date" type="date" class="form-control w-auto" value="@dateValue" />
        <a asp-page="Index" asp-route-date="@ReservationFormatter.InputDate(Model.SelectedDate.AddDays(1))" asp-route-status="@Model.StatusFilter"
           class="btn btn-outline-secondary" aria-label="Next day">&rsaquo;</a>
        @if (Model.StatusFilter is not null)
        {
            <input type="hidden" name="status" value="@Model.StatusFilter" />
        }
        <button type="submit" class="btn btn-outline-secondary">Show</button>
        @if (!isToday)
        {
            <a asp-page="Index" asp-route-status="@Model.StatusFilter" class="btn btn-link">Today</a>
        }
    </form>
</header>

<partial name="_ManageTabs" model="Model.PendingCount" />

@* Status filter: links, so one tap applies it and the choice is in the address. *@
<nav class="nav nav-pills mb-4" aria-label="Status">
    <a asp-page="Index" asp-route-date="@dateValue" class="nav-link @(Model.StatusFilter is null ? "active" : null)"
       aria-current="@(Model.StatusFilter is null ? "page" : null)">All</a>
    @foreach (var status in ReservationStatus.All)
    {
        <a asp-page="Index" asp-route-date="@dateValue" asp-route-status="@status" class="nav-link @(status == Model.StatusFilter ? "active" : null)"
           aria-current="@(status == Model.StatusFilter ? "page" : null)">@ReservationFormatter.StatusLabel(status)</a>
    }
</nav>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="rr-empty">
        <p class="rr-empty__title">@(Model.StatusFilter is null ? "No reservations for this date." : "No reservations with this status for this date.")</p>
        <p class="mb-0">Bookings customers make for this day show up here.</p>
    </div>
}
else
{
    @* One group per seating. The service already sorts by time, then table. *@
    @foreach (var seating in Model.Rows.GroupBy(row => row.Reservation.TimeSlot))
    {
        var seatingId = $"seating-{seating.Key.Hour * 100 + seating.Key.Minute}";
        <section class="mb-4" aria-labelledby="@seatingId">
            <h2 class="rr-group-title" id="@seatingId">
                @ReservationFormatter.Time(seating.Key)
                <span class="rr-count">@seating.Count()</span>
            </h2>
            <ul class="rr-list">
                @foreach (var row in seating)
                {
                    <partial name="_StaffReservationRow" model="row" view-data="rowViewData" />
                }
            </ul>
        </section>
    }
}
