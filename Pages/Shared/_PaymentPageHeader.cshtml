@* Shown at the top of every payment page: loads the payment styles and the flash messages
   (TempData["Success"], ["Error"] or ["Info"] set before a redirect).
   Rendered by the pages themselves so the shared layout does not have to change. *@
<link rel="stylesheet" href="~/css/payments.css" asp-append-version="true" />
@foreach (var (key, css) in new[] { ("Success", "success"), ("Error", "danger"), ("Info", "info") })
{
    if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-@css alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}
