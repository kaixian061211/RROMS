@model RROMS.Web.Pages.Reports.IndexModel
@using RROMS.Web.Pages.Reports
@using static RROMS.Web.Pages.Reports.ReportUi

@if (Model.Report is { } report)
{
    var utilization = report.Utilization;

    <section id="utilization"
             class="mb-5"
             aria-labelledby="utilization-heading">

        <h2 id="utilization-heading" class="mb-3">
            Estimated table utilization
        </h2>

        <p class="text-body-secondary">
            Measures reserved table-slots using current active tables and
            opening hours. This is a reservation-based estimate.
        </p>

        <div class="card mb-4">
            <div class="card-body">
                <dl class="row g-3 mb-0">
                    <div class="col-sm-4">
                        <dt class="small text-body-secondary">
                            Available table-slots
                        </dt>
                        <dd class="h5 mb-0">
                            @Model.Count(utilization.AvailableSlots)
                        </dd>
                    </div>

                    <div class="col-sm-4">
                        <dt class="small text-body-secondary">
                            Booked table-slots
                        </dt>
                        <dd class="h5 mb-0">
                            @Model.Count(utilization.BookedSlots)
                        </dd>
                    </div>

                    <div class="col-sm-4">
                        <dt class="small text-body-secondary">
                            Estimated utilization
                        </dt>
                        <dd class="h5 mb-0">
                            @Model.Percentage(utilization.UtilizationPercent)
                        </dd>
                    </div>
                </dl>

                <p class="small text-body-secondary mt-3 mb-0">
                    One table-slot is one table on one date at one seating time.
                    Pending, confirmed and completed reservations hold slots.
                    Cancelled reservations release them.
                </p>
            </div>
        </div>

        @if (utilization.AvailableSlots == 0)
        {
            <p class="alert alert-info" role="status">
                No table-slots are available under the current configuration
                for this period. Estimated utilization is N/A.
            </p>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="text-body-secondary">
                            Additional duplicate reservations
                        </h3>

                        <p class="h5 mb-2">
                            @Model.Count(utilization.DuplicateBookings)
                        </p>

                        <p class="small text-body-secondary mb-0">
                            Additional non-cancelled reservations repeating
                            the same table, date and seating time.
                            Each distinct slot is counted once in utilization.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="text-body-secondary">
                            Booked slots outside current availability
                        </h3>

                        <p class="h5 mb-2">
                            @Model.Count(utilization.UnmatchedBookings)
                        </p>

                        <p class="small text-body-secondary mb-0">
                            Distinct booked slots that do not match current
                            active tables and allowed seating times.
                            These are excluded from booked table-slots above.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h3 class="">Utilization by table</h3>

                @if (utilization.Tables.Count == 0)
                {
                    <div class="rr-empty"><p class="rr-empty__title">No active tables are available under the current
                        restaurant configuration.
                    </p></div>
                }
                else
                {
                    @if (utilization.Tables.Count > IndexModel.DetailRowLimit)
                    {
                        <p class="small text-body-secondary">
                            Showing the first @IndexModel.DetailRowLimit
                            of @Model.Count(utilization.Tables.Count) tables.
                            Overall figures include all tables.
                        </p>
                    }

                    @await Html.PartialAsync("_ReportTable", new ReportTableModel(
                        $"Estimated booked-slot utilization by table for {report.PeriodLabel}",
                        new[] { "Table", "Dining area", "Seats", "Available slots", "Booked slots", "Estimated utilization" },
                        utilization.Tables.Take(IndexModel.DetailRowLimit).Select(table => new[]
                        {
                            T(table.TableNumber), T(table.Area), N(table.Capacity),
                            N(table.AvailableSlots), N(table.BookedSlots), P(table.UtilizationPercent)
                        }),
                        "No active tables under the current configuration"))

                    <p class="small text-body-secondary mb-0">
                        Seat capacity is shown for reference.
                        Party size does not affect booked-slot utilization.
                    </p>
                }
            </div>
        </div>

        <p class="small text-body-secondary mt-3 mb-0">
            @utilization.Basis
        </p>
    </section>
}
