@page
@model RROMS.Web.Pages.Reports.IndexModel
@using System
@using System.Linq
@using RROMS.Web.Models.Reports
@using RROMS.Web.Pages.Reports
@using static RROMS.Web.Pages.Reports.ReportUi

@{
    ViewData["Title"] = "Analytics and reports";
    var referenceDateText = Model.ReferenceDate.ToString("yyyy-MM-dd");
}

<div class="report-page">
    <header class="rr-page-header">
        <div>
            <h1>Analytics and reports</h1>
            <p class="rr-lede">Review sales, bookings and customer activity.</p>
        </div>
        @if (Model.Report is not null)
        {
            <div class="rr-page-actions report-downloads" aria-label="Download the displayed reporting period">
                <a class="btn btn-outline-secondary" asp-page="/Reports/Index" asp-page-handler="ExportPdf"
                   asp-route-Period="@Model.Period" asp-route-ReferenceDate="@referenceDateText">Download PDF</a>
                <a class="btn btn-outline-secondary" asp-page="/Reports/Index" asp-page-handler="ExportExcel"
                   asp-route-Period="@Model.Period" asp-route-ReferenceDate="@referenceDateText">Excel</a>
                <a class="btn btn-outline-secondary" asp-page="/Reports/Index" asp-page-handler="ExportCsv"
                   asp-route-Period="@Model.Period" asp-route-ReferenceDate="@referenceDateText">CSV</a>
            </div>
        }
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
             class="alert alert-danger"
             role="alert">
        </div>
    }

    <section class="rr-panel mb-4" aria-labelledby="report-filter-heading">
        <div class="p-3 p-md-4">
            <h2 id="report-filter-heading" class="mb-3">Report period</h2>

            <form method="get" asp-page="/Reports/Index" class="report-filter-form">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="Period" class="form-label">Period</label>
                        <select asp-for="Period"
                                asp-items="Html.GetEnumSelectList<ReportPeriod>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Period" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ReferenceDate" class="form-label">Reference date</label>
                        <input asp-for="ReferenceDate"
                               type="date"
                               min="2000-01-01"
                               max="2100-12-31"
                               class="form-control"
                               required />
                        <span asp-validation-for="ReferenceDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Update report</button>
                            <a asp-page="/Reports/Index" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </div>
                </div>

                <p class="form-text mb-0 mt-3">
                    The reference date selects its day, Monday–Sunday week, calendar month or calendar year.
                </p>
            </form>
        </div>
    </section>

    @if (Model.Report is { } report)
    {
        var summaryCards = new (string Label, string Value, string Hint)[]
        {
            ("Gross collections", Model.Money(report.Sales.GrossCollections), "Payments received within the period."),
            ("Net collections", Model.Money(report.Sales.NetCollections), "Gross collections less confirmed refunds."),
            ("Orders placed", Model.Count(report.Orders.OrdersPlaced), "Orders created during the period."),
            ("Scheduled reservations", Model.Count(report.Reservations.ScheduledReservations), "Reservations scheduled during the period."),
            ("Active customers", Model.Count(report.Customers.ActiveCustomers), "Accounts with recorded activity in the period."),
            ("Booked-slot utilization", Model.Percentage(report.Utilization.UtilizationPercent), "Estimate using current tables and opening hours.")
        };

        <section class="rr-panel mb-4" aria-label="Report metadata">
            <div class="p-3 p-md-4">
                <dl class="report-meta">
                    <div>
                        <dt>Selected period</dt>
                        <dd>@report.PeriodLabel</dd>
                    </div>
                    <div>
                        <dt>Generated</dt>
                        <dd>@Model.Timestamp(report.GeneratedAt)</dd>
                    </div>
                    <div>
                        <dt>Currency</dt>
                        <dd>@DashboardReport.Currency</dd>
                    </div>
                    <div>
                        <dt>Time zone</dt>
                        <dd>Malaysia — UTC+8</dd>
                    </div>
                </dl>
            </div>
        </section>

        <p class="report-help report-download-note">
            Downloads include every record in the displayed period and refresh figures when generated.
            Update the report after changing filters. Excel uses separate worksheets; CSV includes all sections.
        </p>

        @if (!Model.HasActivity)
        {
            <div class="rr-empty">
                <p class="rr-empty__title">No data for this period.</p>
                <p>Recorded activity will appear here. Choose another reporting period to view earlier records.</p>
            </div>
        }

        <section class="report-summary mb-4" aria-labelledby="report-summary-heading">
            <div class="report-summary__head">
                <h2 id="report-summary-heading">Overview</h2>

            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 row-cols-xxl-6 g-3">
                @foreach (var card in summaryCards)
                {
                    <div class="col">
                        <article class="rr-panel h-100 report-metric">
                            <div class="p-3">
                                <p class="rr-label mb-2">@card.Label</p>
                                <p class="report-value mb-2">@card.Value</p>
                                <p class="small text-body-secondary mb-0">@card.Hint</p>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </section>

        <nav class="report-nav" aria-label="Report sections">
            <a href="#sales">Sales</a>
            <a href="#orders">Orders</a>
            <a href="#reservations">Reservations</a>
            <a href="#utilization">Table utilization</a>
            <a href="#popular-menu">Popular menu</a>
            <a href="#customers">Customers</a>
        </nav>

        <partial name="_Sales" model="Model" />
        <partial name="_Orders" model="Model" />
        <partial name="_Reservations" model="Model" />
        <partial name="_Utilization" model="Model" />
        <partial name="_PopularMenu" model="Model" />
        <partial name="_Customers" model="Model" />

        <details class="card report-basis mb-4">
            <summary class="card-body">
                How these figures are calculated
            </summary>
            <div class="card-body pt-0">
                <dl class="mb-0">
                    <dt>Sales</dt>
                    <dd>@report.Sales.Basis</dd>

                    <dt>Orders</dt>
                    <dd>@report.Orders.Basis</dd>

                    <dt>Reservations</dt>
                    <dd>@report.Reservations.Basis</dd>

                    <dt>Table utilization</dt>
                    <dd>@report.Utilization.Basis</dd>

                    <dt>Popular menu items</dt>
                    <dd>@report.Menu.Basis</dd>

                    <dt>Customer activity</dt>
                    <dd class="mb-0">@report.Customers.Basis</dd>
                </dl>
            </div>
        </details>

        <section aria-labelledby="report-notes-heading">
            <h2 id="report-notes-heading" class="">Report notes</h2>
            <ul class="small text-body-secondary mb-0">
                @foreach (var note in report.Notes)
                {
                    <li>@note</li>
                }
            </ul>
        </section>
    }
</div>

@section Scripts
{
    @if (Model.Report is not null)
    {
        <script type="application/json" id="report-data">@Html.Raw(Model.ChartJson)</script>
        <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
        <script src="~/js/reports.js" asp-append-version="true"></script>
    }
}
